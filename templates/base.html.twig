<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}EdFolio Blog{% endblock %}</title>
    {% set favicon = config('site.favicon') ?: site_logo %}{% if favicon %}<link rel="icon" href="{{ favicon }}">{% endif %}
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block body %}{% endblock %}
</body>
</html>

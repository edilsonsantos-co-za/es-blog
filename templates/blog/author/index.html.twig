{% extends 'blog/layout.html.twig' %}

{% block title %}{{ author.displayName }} — {{ site_title }}{% endblock %}

{% block content %}
<header class="author-header">
    {% if avatar_url(author) %}
    <img src="{{ avatar_url(author, 240) }}" alt="{{ author.displayName }}" class="author-avatar-large">
    {% else %}
    <div class="author-avatar-large author-avatar-fallback" aria-hidden="true">{{ author.displayName|first|upper }}</div>
    {% endif %}
    <div class="author-header-info">
        <p class="archive-eyebrow">Author</p>
        <h1>{{ author.displayName }}</h1>
        {% if author.about %}
        <p class="author-bio">{{ author.about }}</p>
        {% endif %}
        <div class="author-social">
            {% if author.twitter %}<a href="{{ author.twitter }}" rel="noopener noreferrer" target="_blank">Twitter</a>{% endif %}
            {% if author.github %}<a href="{{ author.github }}" rel="noopener noreferrer" target="_blank">GitHub</a>{% endif %}
            {% if author.linkedin %}<a href="{{ author.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>{% endif %}
            {% if author.bluesky %}<a href="{{ author.bluesky }}" rel="noopener noreferrer" target="_blank">Bluesky</a>{% endif %}
            {% if author.instagram %}<a href="{{ author.instagram }}" rel="noopener noreferrer" target="_blank">Instagram</a>{% endif %}
            {% if author.facebook %}<a href="{{ author.facebook }}" rel="noopener noreferrer" target="_blank">Facebook</a>{% endif %}
        </div>
    </div>
</header>

<section class="section-heading compact" aria-labelledby="author-posts-heading">
    <p>Published by {{ author.displayName }}</p>
    <h2 id="author-posts-heading">Posts</h2>
</section>

{% include 'blog/_post_list.html.twig' with {posts: posts, route: 'app_blog_author', route_params: {username: author.username}} %}
{% endblock %}

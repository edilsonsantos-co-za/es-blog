<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# es-boot.css: the splash shown while a page is still arriving; first, so it applies before anything paints #}
    <link rel="stylesheet" href="{{ asset('assets/es-boot.css') }}?v={{ asset_version('assets/es-boot.css') }}">
    <title>{% block title %}{{ site_title }}{% endblock %}</title>

    {% block meta_description %}
    {% if site_description is defined and site_description %}
    <meta name="description" content="{{ site_description }}">
    {% endif %}
    {% endblock %}

    {% block canonical %}{% endblock %}

    {% block opengraph %}
    <meta property="og:site_name" content="{{ site_title }}">
    <meta property="og:type" content="website">
    {% endblock %}

    <script src="{{ asset('assets/es-apps.js') }}?v={{ asset_version('assets/es-apps.js') }}" defer></script>

    {% block css %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Manrope:wght@500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/blog/atlas.css') }}?v={{ asset_version('assets/blog/atlas.css') }}">
    {# Atlas 2 refresh layer (trial): remove this line to go back to plain Atlas #}
    <link rel="stylesheet" href="{{ asset('assets/blog/atlas-refresh.css') }}?v={{ asset_version('assets/blog/atlas-refresh.css') }}">
    {% endblock %}

    {% set favicon = config('site.favicon') ?: site_logo %}<link rel="icon" href="{{ favicon ?: asset('assets/brand/es-mark.svg') }}">

    <link rel="alternate" type="application/rss+xml" title="{{ site_title }} RSS Feed" href="{{ path('app_blog_feed') }}">
</head>
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url : '' %}
{% set store_url = site_store_url starts with 'http' ? site_store_url : '' %}
{% set current_route = app.request.attributes.get('_route') %}
<body class="theme-atlas {% block body_class %}{% endblock %}">
<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead">
    <div class="wrap mast-row">
        <a href="{{ path('app_blog_index') }}" class="brand" aria-label="{{ site_title }} home">
            {% if site_logo %}
                <span class="logo logo-img"><img src="{{ site_logo }}" alt=""></span>
            {% else %}
                <span class="logo" aria-hidden="true">{{ site_title|first|upper }}</span>
            {% endif %}
            <span class="brand-text">
                <b>{{ site_title }}</b>
                <small class="mono">Blog</small>
            </span>
        </a>

        <nav class="mast-nav" aria-label="Primary navigation">
            <ul class="nav" id="menu">
                <li><a href="{{ path('app_blog_posts') }}"{% if current_route == 'app_blog_posts' %} aria-current="page"{% endif %}>Posts</a></li>
                {% for item in menu_items %}
                    {% set has_children = item.children is defined and item.children|length > 0 %}
                    <li{% if has_children %} class="has-sub"{% endif %}>
                        <a href="{{ item.url }}">{{ item.label }}</a>
                        {% if has_children %}
                        <ul class="sub">
                            {% for child in item.children %}
                            <li><a href="{{ child.url }}">{{ child.label }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                {% endfor %}
                {% for cat in all_categories|slice(0, 3) %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}"{% if app.request.attributes.get('slug') == cat.slug and current_route == 'app_blog_category' %} aria-current="page"{% endif %}>{{ cat.title }}</a></li>
                {% endfor %}
                <li><a href="{{ path('app_newsletter_subscribe') }}"{% if current_route starts with 'app_newsletter' %} aria-current="page"{% endif %}>Newsletter</a></li>
                <li><a href="{{ path('app_blog_feed') }}" type="application/rss+xml" target="_blank" rel="noopener">RSS ↗</a></li>
                <li class="nav-mobile-only search-link"><a href="{{ path('app_blog_search') }}">Search</a></li>
            </ul>
        </nav>

        <form class="mast-search" action="{{ path('app_blog_search') }}" method="get" role="search">
            <label class="sr-only" for="mast-search-input">Search posts</label>
            <span aria-hidden="true">⌕</span>
            <input id="mast-search-input" type="search" name="q" placeholder="Search posts" value="{{ app.request.query.get('q') }}">
            <kbd aria-hidden="true">/</kbd>
        </form>

        <div class="top-actions">
            {# The ES app launcher and account menu, shared by every ES app (public/assets/es-apps.js) #}
            {% if site_coffee_url %}<a class="btn coffee" href="{{ site_coffee_url }}" target="_blank" rel="noopener" aria-label="Buy me a coffee"><svg class="coffee-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.067 2.017.144l.228.031c.267.04.533.088.798.145.392.085.895.113 1.07.542.055.137.08.288.111.431l.319 1.484a.237.237 0 01-.199.284h-.003c-.037.006-.075.01-.112.015a36.704 36.704 0 01-4.743.295 37.059 37.059 0 01-4.699-.304c-.14-.017-.293-.042-.417-.06-.326-.048-.649-.108-.973-.161-.393-.065-.768-.032-1.123.161-.29.16-.527.404-.675.701-.154.316-.199.66-.267 1-.069.34-.176.707-.135 1.056.087.753.613 1.365 1.37 1.502a39.69 39.69 0 0011.343.376.483.483 0 01.535.53l-.071.697-1.018 9.907c-.041.41-.047.832-.125 1.237-.122.637-.553 1.028-1.182 1.171-.577.131-1.165.2-1.756.205-.656.004-1.31-.025-1.966-.022-.699.004-1.556-.06-2.095-.58-.475-.458-.54-1.174-.605-1.793l-.731-7.013-.322-3.094c-.037-.351-.286-.695-.678-.678-.336.015-.718.3-.678.679l.228 2.185.949 9.112c.147 1.344 1.174 2.068 2.446 2.272.742.12 1.503.144 2.257.156.966.016 1.942.053 2.892-.122 1.408-.258 2.465-1.198 2.616-2.657.34-3.332.683-6.663 1.024-9.995l.215-2.087a.484.484 0 01.39-.426c.402-.078.787-.212 1.074-.518.455-.488.546-1.124.385-1.766zm-1.478.772c-.145.137-.363.201-.578.233-2.416.359-4.866.54-7.308.46-1.748-.06-3.477-.254-5.207-.498-.17-.024-.353-.055-.47-.18-.22-.236-.111-.71-.054-.995.052-.26.152-.609.463-.646.484-.057 1.046.148 1.526.22.577.088 1.156.159 1.737.212 2.48.226 5.002.19 7.472-.14.45-.06.899-.13 1.345-.21.399-.072.84-.206 1.08.206.166.281.188.657.162.974a.544.544 0 01-.169.364zm-6.159 3.9c-.862.37-1.84.788-3.109.788a5.884 5.884 0 01-1.569-.217l.877 9.004c.065.78.717 1.38 1.5 1.38 0 0 1.243.065 1.658.065.447 0 1.786-.065 1.786-.065.783 0 1.434-.6 1.499-1.38l.94-9.95a3.996 3.996 0 00-1.322-.238c-.826 0-1.491.284-2.26.613z"/></svg><span class="coffee-text">Buy me a coffee</span></a>{% endif %}
            <es-apps current="blog" dashboard-url="{{ path('app_admin_dashboard') }}" {% if app.user %}signed-in owner user-name="{{ app.user.username }}" user-email="{{ app.user.email }}" avatar="{{ gravatar_url(app.user, 128) }}" manage-url="{{ path('app_admin_profile') }}" sign-out-url="{{ path('app_logout') }}"{% else %}sign-in-url="{{ path('app_login') }}"{% endif %}></es-apps>
            <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">☰</button>
        </div>
    </div>
</header>
{# Phones and tablets: the app-style bottom tab bar every ES app shares (public/assets/es-apps.js); it replaces the ☰ menu.
   The categories and menu items of #menu join it under More. #}
<es-tabbar hide=".menu-btn, .mast-nav, .mast-search" source="#menu">
    <a href="{{ path('app_blog_index') }}" data-icon="home"{% if current_route == 'app_blog_index' %} aria-current="page"{% endif %}>Home</a>
    <a href="{{ path('app_blog_posts') }}" data-icon="posts"{% if current_route in ['app_blog_posts', 'app_blog_post'] %} aria-current="page"{% endif %}>Posts</a>
    <a href="{{ path('app_blog_search') }}" data-icon="search"{% if current_route == 'app_blog_search' %} aria-current="page"{% endif %}>Search</a>
    <a href="{{ path('app_newsletter_subscribe') }}" data-icon="newsletter"{% if current_route starts with 'app_newsletter' %} aria-current="page"{% endif %}>Newsletter</a>
</es-tabbar>

<div class="wrap page {% block page_class %}with-sidebar{% endblock %}">
    <main class="main-content" id="main" tabindex="-1">
        {% block content %}{% endblock %}
    </main>

    {% block sidebar_wrap %}
    <aside class="sidebar" id="sidebar" aria-label="Blog sidebar">
        {% block sidebar %}
        <div class="tile widget widget-search">
            <h2 class="label">Search</h2>
            <form action="{{ path('app_blog_search') }}" method="get" class="search-form">
                <label class="sr-only" for="sidebar-search">Search posts</label>
                <input id="sidebar-search" type="text" name="q" placeholder="Symfony, Docker…" class="search-input">
                <button type="submit" class="btn primary search-btn">Go</button>
            </form>
        </div>

        {% if recent_posts|length > 0 %}
        <div class="tile widget widget-recent-posts">
            <h2 class="label">Recently published</h2>
            <ul class="sidebar-link-list">
                {% for p in recent_posts %}
                <li>
                    <a href="{{ path('app_blog_post', {
                        year: (p.publishedAt ?? p.createdAt)|date('Y'),
                        month: (p.publishedAt ?? p.createdAt)|date('m'),
                        slug: p.slug
                    }) }}">{{ p.title }}</a>
                    <span class="mono">{{ (p.publishedAt ?? p.createdAt)|date('M j, Y') }}</span>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if tag_cloud|length > 0 %}
        <div class="tile widget widget-tags">
            <h2 class="label">Tags</h2>
            <div class="tag-cloud">
                {% for item in tag_cloud %}
                <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">
                    {{ item.tag.name }} <span class="tag-count">{{ item.postCount }}</span>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if all_categories|length > 0 %}
        <div class="tile widget widget-categories">
            <h2 class="label">Categories</h2>
            <ul class="sidebar-link-list compact">
                {% for cat in all_categories %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}">{{ cat.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        {% endblock %}
    </aside>
    {% endblock %}
</div>

{# Same footer in every ES app: brand and one line, three short columns, then a thin bottom bar (atlas-refresh.css). #}
<footer class="site-foot">
    <div class="wrap foot">
        <div class="foot-about">
            <a class="brand foot-brand" href="{{ path('app_blog_index') }}">
                {% if site_logo %}
                    <span class="logo logo-img"><img src="{{ site_logo }}" alt=""></span>
                {% else %}
                    <span class="logo" aria-hidden="true">{{ site_title|first|upper }}</span>
                {% endif %}
                <span class="brand-text"><b>{{ site_title }}</b><small class="mono">Blog</small></span>
            </a>
            <p>Full-time professional software engineer, building cool projects in my spare time.</p>
        </div>
        <nav class="foot-cols" aria-label="Footer">
            <div class="foot-col">
                <h2>Blog</h2>
                <ul>
                    <li><a href="{{ path('app_blog_posts') }}">Posts</a></li>
                    <li><a href="{{ path('app_blog_search') }}">Search</a></li>
                    <li><a href="{{ path('app_newsletter_subscribe') }}">Newsletter</a></li>
                    <li><a href="{{ path('app_blog_feed') }}" type="application/rss+xml" target="_blank" rel="noopener">RSS ↗</a></li>
                </ul>
            </div>
            <div class="foot-col">
                <h2>ES apps</h2>
                <ul>
                    {% if portfolio_url %}<li><a href="{{ portfolio_url }}">Portfolio</a></li>{% endif %}
                    {% if site_developers_url %}<li><a href="{{ site_developers_url }}">Developers</a></li>{% endif %}
                    {% if store_url %}<li><a href="{{ store_url }}">Store</a></li>{% endif %}
                </ul>
            </div>
            <div class="foot-col">
                <h2>Connect</h2>
                {# Icons, not words: the name is in aria-label and the hover title #}
                {% import '_connect_icons.html.twig' as connect %}
                {# The same Connect links as the portfolio footer, in the same order: LinkedIn, GitHub, Buy me a coffee #}
                <ul class="connect">
                    <li><a href="https://www.linkedin.com/in/edilsonsantos-co-za/" rel="noopener" target="_blank" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">{{ connect.icon('linkedin') }}</a></li>
                    <li><a href="https://github.com/edilsonsantos-co-za" rel="noopener" target="_blank" aria-label="GitHub (opens in a new tab)" title="GitHub">{{ connect.icon('github') }}</a></li>
                    {% if site_coffee_url %}<li><a href="{{ site_coffee_url }}" rel="noopener" target="_blank" aria-label="Buy me a coffee (opens in a new tab)" title="Buy me a coffee">{{ connect.icon('coffee') }}</a></li>{% endif %}
                </ul>
            </div>
        </nav>
        <div class="foot-bottom mono">
            <span>&copy; {{ "now"|date("Y") }} {{ site_title }}{% if app_release_tag %} · {{ app_release_tag }}{% endif %}</span>
            <span>Made in Johannesburg</span>
        </div>
    </div>
</footer>

<script>
(function () {
    var menuBtn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu');
    menuBtn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
        }, { threshold: 0.08 });
        document.querySelectorAll('.post-row, .hero > *').forEach(function (el) {
            el.classList.add('reveal');
            io.observe(el);
        });
    }

    var searchInput = document.getElementById('mast-search-input');
    document.addEventListener('keydown', function (e) {
        var tag = (e.target.tagName || '').toLowerCase();
        if (e.key === '/' && searchInput && tag !== 'input' && tag !== 'textarea') {
            e.preventDefault();
            searchInput.focus();
        }
    });

    var clock = document.querySelector('[data-clock]');
    if (clock) {
        var tz = clock.getAttribute('data-clock');
        var tick = function () {
            try {
                clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: tz });
            } catch (e) {
                clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            }
        };
        tick();
        setInterval(tick, 15000);
    }
})();
</script>
</body>
</html>

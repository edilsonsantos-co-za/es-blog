<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ site_title }}{% endblock %}</title>

    {% block meta_description %}
    {% if site_description is defined and site_description %}
    <meta name="description" content="{{ site_description }}">
    {% endif %}
    {% endblock %}

    {% block canonical %}{% endblock %}

    {% block opengraph %}
    <meta property="og:site_name" content="{{ site_title }}">
    <meta property="og:type" content="website">
    {% endblock %}

    <script src="{{ asset('assets/es-apps.js') }}?v={{ asset_version('assets/es-apps.js') }}" defer></script>

    {% block css %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Manrope:wght@500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/blog/atlas.css') }}?v={{ asset_version('assets/blog/atlas.css') }}">
    {# Atlas 2 refresh layer (trial): remove this line to go back to plain Atlas #}
    <link rel="stylesheet" href="{{ asset('assets/blog/atlas-refresh.css') }}">
    {% endblock %}

    {% set favicon = config('site.favicon') ?: site_logo %}<link rel="icon" href="{{ favicon ?: asset('assets/brand/es-mark.svg') }}">

    <link rel="alternate" type="application/rss+xml" title="{{ site_title }} RSS Feed" href="{{ path('app_blog_feed') }}">
</head>
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url : '' %}
{% set store_url = site_store_url starts with 'http' ? site_store_url : '' %}
{% set current_route = app.request.attributes.get('_route') %}
<body class="theme-atlas {% block body_class %}{% endblock %}">
<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead">
    <div class="wrap mast-row">
        <a href="{{ path('app_blog_index') }}" class="brand" aria-label="{{ site_title }} home">
            {% if site_logo %}
                <span class="logo logo-img"><img src="{{ site_logo }}" alt=""></span>
            {% else %}
                <span class="logo" aria-hidden="true">{{ site_title|first|upper }}</span>
            {% endif %}
            <span class="brand-text">
                <b>{{ site_title }}</b>
                <small class="mono">Blog</small>
            </span>
        </a>

        <nav class="mast-nav" aria-label="Primary navigation">
            <ul class="nav" id="menu">
                <li><a href="{{ path('app_blog_posts') }}"{% if current_route == 'app_blog_posts' %} aria-current="page"{% endif %}>Posts</a></li>
                {% for item in menu_items %}
                    {% set has_children = item.children is defined and item.children|length > 0 %}
                    <li{% if has_children %} class="has-sub"{% endif %}>
                        <a href="{{ item.url }}">{{ item.label }}</a>
                        {% if has_children %}
                        <ul class="sub">
                            {% for child in item.children %}
                            <li><a href="{{ child.url }}">{{ child.label }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                {% endfor %}
                {% for cat in all_categories|slice(0, 3) %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}"{% if app.request.attributes.get('slug') == cat.slug and current_route == 'app_blog_category' %} aria-current="page"{% endif %}>{{ cat.title }}</a></li>
                {% endfor %}
                <li><a href="{{ path('app_newsletter_subscribe') }}"{% if current_route starts with 'app_newsletter' %} aria-current="page"{% endif %}>Newsletter</a></li>
                <li><a href="{{ path('app_blog_feed') }}" type="application/rss+xml" target="_blank" rel="noopener">RSS ↗</a></li>
                <li class="nav-mobile-only search-link"><a href="{{ path('app_blog_search') }}">Search</a></li>
            </ul>
        </nav>

        <form class="mast-search" action="{{ path('app_blog_search') }}" method="get" role="search">
            <label class="sr-only" for="mast-search-input">Search posts</label>
            <span aria-hidden="true">⌕</span>
            <input id="mast-search-input" type="search" name="q" placeholder="Search posts" value="{{ app.request.query.get('q') }}">
            <kbd aria-hidden="true">/</kbd>
        </form>

        <div class="top-actions">
            {# The ES app launcher and account menu, shared by every ES app (public/assets/es-apps.js) #}
            {% if site_coffee_url %}<a class="btn coffee" href="{{ site_coffee_url }}" target="_blank" rel="noopener" aria-label="Buy me a coffee">☕<span class="coffee-text">Buy me a coffee</span></a>{% endif %}
            <es-apps current="blog" dashboard-url="{{ path('app_admin_dashboard') }}" {% if app.user %}signed-in user-name="{{ app.user.username }}" user-email="{{ app.user.email }}" avatar="{{ gravatar_url(app.user, 128) }}" manage-url="{{ path('app_admin_profile') }}" sign-out-url="{{ path('app_logout') }}"{% else %}sign-in-url="{{ path('app_login') }}"{% endif %}></es-apps>
            <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">☰</button>
        </div>
    </div>
</header>

<div class="wrap page {% block page_class %}with-sidebar{% endblock %}">
    <main class="main-content" id="main" tabindex="-1">
        {% block content %}{% endblock %}
    </main>

    {% block sidebar_wrap %}
    <aside class="sidebar" id="sidebar" aria-label="Blog sidebar">
        {% block sidebar %}
        <div class="tile widget widget-search">
            <h2 class="label">Search</h2>
            <form action="{{ path('app_blog_search') }}" method="get" class="search-form">
                <label class="sr-only" for="sidebar-search">Search posts</label>
                <input id="sidebar-search" type="text" name="q" placeholder="Symfony, Docker…" class="search-input">
                <button type="submit" class="btn primary search-btn">Go</button>
            </form>
        </div>

        {% if recent_posts|length > 0 %}
        <div class="tile widget widget-recent-posts">
            <h2 class="label">Recently published</h2>
            <ul class="sidebar-link-list">
                {% for p in recent_posts %}
                <li>
                    <a href="{{ path('app_blog_post', {
                        year: (p.publishedAt ?? p.createdAt)|date('Y'),
                        month: (p.publishedAt ?? p.createdAt)|date('m'),
                        slug: p.slug
                    }) }}">{{ p.title }}</a>
                    <span class="mono">{{ (p.publishedAt ?? p.createdAt)|date('M j, Y') }}</span>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if tag_cloud|length > 0 %}
        <div class="tile widget widget-tags">
            <h2 class="label">Tags</h2>
            <div class="tag-cloud">
                {% for item in tag_cloud %}
                <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">
                    {{ item.tag.name }} <span class="tag-count">{{ item.postCount }}</span>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if all_categories|length > 0 %}
        <div class="tile widget widget-categories">
            <h2 class="label">Categories</h2>
            <ul class="sidebar-link-list compact">
                {% for cat in all_categories %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}">{{ cat.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        {% endblock %}
    </aside>
    {% endblock %}
</div>

{# Same footer in every ES app: brand and one line, three short columns, then a thin bottom bar (atlas-refresh.css). #}
<footer class="site-foot">
    <div class="wrap foot">
        <div class="foot-about">
            <a class="brand foot-brand" href="{{ path('app_blog_index') }}">
                {% if site_logo %}
                    <span class="logo logo-img"><img src="{{ site_logo }}" alt=""></span>
                {% else %}
                    <span class="logo" aria-hidden="true">{{ site_title|first|upper }}</span>
                {% endif %}
                <span class="brand-text"><b>{{ site_title }}</b><small class="mono">Blog</small></span>
            </a>
            <p>Full-time professional software engineer, building cool projects in my spare time.</p>
        </div>
        <nav class="foot-cols" aria-label="Footer">
            <div class="foot-col">
                <h2>Blog</h2>
                <ul>
                    <li><a href="{{ path('app_blog_posts') }}">Posts</a></li>
                    <li><a href="{{ path('app_blog_search') }}">Search</a></li>
                    <li><a href="{{ path('app_newsletter_subscribe') }}">Newsletter</a></li>
                    <li><a href="{{ path('app_blog_feed') }}" type="application/rss+xml" target="_blank" rel="noopener">RSS ↗</a></li>
                </ul>
            </div>
            <div class="foot-col">
                <h2>ES apps</h2>
                <ul>
                    {% if portfolio_url %}<li><a href="{{ portfolio_url }}">Portfolio</a></li>{% endif %}
                    {% if site_developers_url %}<li><a href="{{ site_developers_url }}">Developers</a></li>{% endif %}
                    {% if store_url %}<li><a href="{{ store_url }}">Store</a></li>{% endif %}
                </ul>
            </div>
            <div class="foot-col">
                <h2>Connect</h2>
                <ul>
                    {% if portfolio_url %}<li><a href="{{ portfolio_url|trim('/', 'right') }}/contact">Contact</a></li>{% endif %}
                    {% if site_upwork_url %}<li><a href="{{ site_upwork_url }}" rel="noopener noreferrer" target="_blank">Hire on Upwork ↗</a></li>{% endif %}
                    {% if site_support_url %}<li><a href="{{ site_support_url }}" rel="noopener noreferrer" target="_blank">Support the work ↗</a></li>{% endif %}
                    {% if site_coffee_url %}<li><a href="{{ site_coffee_url }}" rel="noopener" target="_blank">Buy me a coffee ↗</a></li>{% endif %}
                </ul>
            </div>
        </nav>
        <div class="foot-bottom mono">
            <span>&copy; {{ "now"|date("Y") }} {{ site_title }}{% if app_release_tag %} · {{ app_release_tag }}{% endif %}</span>
            <span>Made in Johannesburg</span>
        </div>
    </div>
</footer>

<script>
(function () {
    var menuBtn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu');
    menuBtn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
        }, { threshold: 0.08 });
        document.querySelectorAll('.post-row, .hero > *').forEach(function (el) {
            el.classList.add('reveal');
            io.observe(el);
        });
    }

    var searchInput = document.getElementById('mast-search-input');
    document.addEventListener('keydown', function (e) {
        var tag = (e.target.tagName || '').toLowerCase();
        if (e.key === '/' && searchInput && tag !== 'input' && tag !== 'textarea') {
            e.preventDefault();
            searchInput.focus();
        }
    });

    var clock = document.querySelector('[data-clock]');
    if (clock) {
        var tz = clock.getAttribute('data-clock');
        var tick = function () {
            try {
                clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: tz });
            } catch (e) {
                clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            }
        };
        tick();
        setInterval(tick, 15000);
    }
})();
</script>
</body>
</html>

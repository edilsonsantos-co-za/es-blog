<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ site_title }}{% endblock %}</title>

    {% block meta_description %}
    {% if site_description is defined and site_description %}
    <meta name="description" content="{{ site_description }}">
    {% endif %}
    {% endblock %}

    {% block canonical %}{% endblock %}

    {% block opengraph %}
    <meta property="og:site_name" content="{{ site_title }}">
    <meta property="og:type" content="website">
    {% endblock %}

    {% block css %}
    <link rel="stylesheet" href="/assets/blog/style.css">
    {% endblock %}

    <link rel="alternate" type="application/rss+xml" title="{{ site_title }} RSS Feed" href="{{ path('app_blog_feed') }}">
</head>
<body>

<header class="site-header">
    <div class="container">
        <div class="site-branding">
            {% if site_logo %}
                <a href="{{ path('app_blog_index') }}" class="site-logo-link">
                    <img src="{{ site_logo }}" alt="{{ site_title }}" class="site-logo">
                </a>
            {% else %}
                <a href="{{ path('app_blog_index') }}" class="site-title-link">
                    <h1 class="site-title">{{ site_title }}</h1>
                </a>
            {% endif %}
            {% if site_description %}
                <p class="site-description">{{ site_description }}</p>
            {% endif %}
        </div>

        <nav class="site-nav" aria-label="Primary navigation">
            <ul>
                <li><a href="{{ path('app_blog_index') }}">Home</a></li>
                {% for item in menu_items %}
                    <li{% if item.children is defined and item.children|length > 0 %} class="has-sub-menu"{% endif %}>
                        <a href="{{ item.url }}"{% if item.children is defined and item.children|length > 0 %} aria-haspopup="true"{% endif %}>{{ item.label }}</a>
                        {% if item.children is defined and item.children|length > 0 %}
                        <ul class="sub-menu">
                            {% for child in item.children %}
                            <li><a href="{{ child.url }}">{{ child.label }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>
</header>

<div class="site-body container">
    <main class="main-content" id="main">
        {% block content %}{% endblock %}
    </main>

    <aside class="sidebar" id="sidebar">
        {% block sidebar %}
        <div class="widget widget-search">
            <h3 class="widget-title">Search</h3>
            <form action="{{ path('app_blog_search') }}" method="get" class="search-form">
                <input type="text" name="q" placeholder="Search…" class="search-input" aria-label="Search">
                <button type="submit" class="search-btn">Go</button>
            </form>
        </div>

        {% if recent_posts|length > 0 %}
        <div class="widget widget-recent-posts">
            <h3 class="widget-title">Recent Posts</h3>
            <ul>
                {% for p in recent_posts %}
                <li>
                    <a href="{{ path('app_blog_post', {
                        year: (p.publishedAt ?? p.createdAt)|date('Y'),
                        month: (p.publishedAt ?? p.createdAt)|date('m'),
                        slug: p.slug
                    }) }}">{{ p.title }}</a>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if tag_cloud|length > 0 %}
        <div class="widget widget-tags">
            <h3 class="widget-title">Tags</h3>
            <div class="tag-cloud">
                {% for item in tag_cloud %}
                <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">
                    {{ item.tag.name }} <span class="tag-count">({{ item.postCount }})</span>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if all_categories|length > 0 %}
        <div class="widget widget-categories">
            <h3 class="widget-title">Categories</h3>
            <ul>
                {% for cat in all_categories %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}">{{ cat.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        {% endblock %}
    </aside>
</div>

<footer class="site-footer">
    <div class="container">
        <p>&copy; {{ "now"|date("Y") }} {{ site_title }}. All rights reserved.</p>
        <p>Release {{ app_release_tag }}</p>
    </div>
</footer>

</body>
</html>

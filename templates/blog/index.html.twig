{% extends 'blog/layout.html.twig' %}

{% block title %}{{ site_title }}{% endblock %}

{% block page_class %}no-sidebar{% endblock %}
{% block sidebar_wrap %}{% endblock %}

{% block content %}
{% set first_page = posts is null or posts.currentPageNumber == 1 %}
{% set latest = first_page and posts is not null and posts|length > 0 ? posts|first : null %}
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url : '' %}
{% set post_total = posts is not null ? posts.totalItemCount : 0 %}

{% if first_page %}
{# Editorial bento: the latest post leads with its cover (or generative cover art drawn from its title), the next two
   sit beside the masthead, and topics, counts and the feed fill the bottom row. With no posts yet, topics lead. #}
{% set recent = posts is not null ? posts|slice(0, 3) : [] %}
{% set lead = recent|first %}
{% set side = recent|slice(1, 2) %}
{% set topic_total = tag_cloud|length %}
<section class="hero hero-bento{{ lead ? '' : ' hero-solo' }}" aria-label="Featured">
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="tile masthead-tile{{ side|length == 0 ? ' tall' : '' }}">
        <span class="label">Latest writing</span>
        <h1>{{ site_description ?: site_title }}</h1>
        <div class="actions">
            {% if lead %}<a class="btn btn-primary" href="#latest-posts-heading">Start reading</a>{% endif %}
            {% if portfolio_url %}<a class="btn" href="{{ portfolio_url }}">About me ↗</a>{% endif %}
        </div>
    </div>
    {% if lead %}
    {% set lead_date = lead.publishedAt ?? lead.createdAt %}
    {% set lead_kicker = lead.category ? lead.category.title : 'Article' %}
    <a class="tile story story-lead" href="{{ path('app_blog_post', {year: lead_date|date('Y'), month: lead_date|date('m'), slug: lead.slug}) }}">
        <span class="cover-art">{% if lead.image %}<img src="{{ lead.image }}" alt="" loading="eager">{% else %}<canvas data-cover="{{ lead.title }}" data-palette="{{ lead_kicker }}" aria-hidden="true"></canvas>{% endif %}</span>
        <span class="story-kicker">Latest · {{ lead_kicker }}</span>
        <span class="story-body">
            <span class="mono">{{ lead_date|date('j M Y') }} · {{ reading_time(lead.body) }} min read</span>
            <strong>{{ lead.title }}</strong>
            <span class="story-excerpt">{{ lead.description ?: excerpt(lead.body|markdown, 160) }}</span>
        </span>
    </a>
    {% for post in side %}
    {% set post_date = post.publishedAt ?? post.createdAt %}
    {% set kicker = post.category ? post.category.title : 'Article' %}
    <a class="tile story{{ side|length == 1 ? ' wide' : '' }}" href="{{ path('app_blog_post', {year: post_date|date('Y'), month: post_date|date('m'), slug: post.slug}) }}">
        <span class="cover-art">{% if post.image %}<img src="{{ post.image }}" alt="" loading="lazy">{% else %}<canvas data-cover="{{ post.title }}" data-palette="{{ kicker }}" aria-hidden="true"></canvas>{% endif %}</span>
        <span class="story-kicker">{{ kicker }}</span>
        <span class="story-body">
            <span class="mono">{{ post_date|date('j M Y') }} · {{ reading_time(post.body) }} min</span>
            <strong>{{ post.title }}</strong>
        </span>
    </a>
    {% endfor %}
    {% endif %}
    {% if topic_total > 0 %}
    <nav class="tile topics-tile" aria-label="Topics">
        <span class="label">Topics</span>
        <div class="tag-cloud">
            {% for item in tag_cloud|slice(0, 14) %}
            <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">#{{ item.tag.name }} <span class="tag-count">{{ item.postCount }}</span></a>
            {% endfor %}
        </div>
    </nav>
    {% endif %}
    <div class="tile stat-tile">
        <span class="label">Published</span>
        <b>{{ post_total }}</b>
        <span class="label">post{{ post_total == 1 ? '' : 's' }}{% if topic_total %} · {{ topic_total }} topic{{ topic_total == 1 ? '' : 's' }}{% endif %}</span>
    </div>
    <a class="tile feed-tile{{ topic_total ? '' : ' wide' }}" href="{{ path('app_blog_feed') }}">
        <span class="label">Subscribe</span>
        <strong>New posts in your feed reader.</strong>
        <span class="label">RSS ↗</span>
    </a>
</section>
{% endif %}

<section class="list-head" aria-labelledby="latest-posts-heading">
    <h2 id="latest-posts-heading">{{ first_page ? 'All writing' : 'All writing · page ' ~ posts.currentPageNumber }}</h2>
    <a class="list-head-link" href="{{ path('app_blog_feed') }}">RSS</a>
</section>

{% include 'blog/_post_list.html.twig' with {posts: posts, route: 'app_blog_index', route_params: {}} %}
{% endblock %}

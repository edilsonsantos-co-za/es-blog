{% extends 'blog/layout.html.twig' %}

{% block title %}{{ site_title }}{% endblock %}

{% block page_class %}no-sidebar{% endblock %}
{% block sidebar_wrap %}{% endblock %}

{% block content %}
{# The landing page: the hero bento, then the blog in numbers. Every post is on the Posts page (app_blog_posts). #}
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url : '' %}
{% set post_total = posts is not null ? posts.totalItemCount : 0 %}

{# Editorial bento: the latest post leads with its cover (or generative cover art drawn from its title), the next two
   sit beside the masthead, and topics, counts and the feed fill the bottom row. With no posts yet, topics lead. #}
{% set recent = posts is not null ? posts|slice(0, 3) : [] %}
{% set lead = recent|first %}
{% set side = recent|slice(1, 2) %}
{% set topic_total = tag_cloud|length %}
<section class="hero hero-bento" aria-label="Featured">
    <div class="tile masthead-tile">
        <span class="label">Edilson Santos · Blog</span>
        <h1>{{ site_description ?: site_title }}</h1>
        <div class="actions">
            {% if lead %}<a class="btn btn-primary" href="{{ path('app_blog_post', {year: (lead.publishedAt ?? lead.createdAt)|date('Y'), month: (lead.publishedAt ?? lead.createdAt)|date('m'), slug: lead.slug}) }}">Start reading</a>{% endif %}
            <a class="btn" href="{{ path('app_blog_posts') }}">All posts →</a>
            {% if portfolio_url %}<a class="btn" href="{{ portfolio_url }}">About me ↗</a>{% endif %}
        </div>
    </div>
    {% if lead %}
    {% set lead_date = lead.publishedAt ?? lead.createdAt %}
    {% set lead_kicker = lead.category ? lead.category.title : 'Article' %}
    <a class="tile story story-lead" href="{{ path('app_blog_post', {year: lead_date|date('Y'), month: lead_date|date('m'), slug: lead.slug}) }}">
        <span class="cover-art">{% if lead.image %}<img src="{{ lead.image }}" alt="" loading="eager">{% else %}<canvas data-cover="{{ lead.title }}" data-palette="{{ lead_kicker }}" aria-hidden="true"></canvas>{% endif %}</span>
        <span class="story-kicker">Latest · {{ lead_kicker }}</span>
        <span class="story-body">
            <span class="mono">{{ lead_date|date('j M Y') }} · {{ reading_time(lead.body) }} min read</span>
            <strong>{{ lead.title }}</strong>
            <span class="story-excerpt">{{ lead.description ?: excerpt(lead.body|markdown, 160) }}</span>
        </span>
    </a>
    {% for post in side %}
    {% set post_date = post.publishedAt ?? post.createdAt %}
    {% set kicker = post.category ? post.category.title : 'Article' %}
    <a class="tile story{{ side|length == 1 ? ' wide' : '' }}" href="{{ path('app_blog_post', {year: post_date|date('Y'), month: post_date|date('m'), slug: post.slug}) }}">
        <span class="cover-art">{% if post.image %}<img src="{{ post.image }}" alt="" loading="lazy">{% else %}<canvas data-cover="{{ post.title }}" data-palette="{{ kicker }}" aria-hidden="true"></canvas>{% endif %}</span>
        <span class="story-kicker">{{ kicker }}</span>
        <span class="story-body">
            <span class="mono">{{ post_date|date('j M Y') }} · {{ reading_time(post.body) }} min</span>
            <strong>{{ post.title }}</strong>
        </span>
    </a>
    {% endfor %}
    {% endif %}
    {% if topic_total > 0 %}
    <nav class="tile topics-tile{{ side|length > 0 ? ' wide' : '' }}" aria-label="Topics">
        <span class="label">Topics</span>
        <div class="tag-cloud">
            {% for item in tag_cloud|slice(0, 14) %}
            <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">#{{ item.tag.name }} <span class="tag-count">{{ item.postCount }}</span></a>
            {% endfor %}
        </div>
    </nav>
    {% endif %}
    <div class="tile stat-tile">
        <span class="label">Published</span>
        <b>{{ post_total }}</b>
        <span class="label">post{{ post_total == 1 ? '' : 's' }}{% if topic_total %} · {{ topic_total }} topic{{ topic_total == 1 ? '' : 's' }}{% endif %}</span>
    </div>
    <a class="tile feed-tile{{ topic_total ? '' : ' wide' }}" href="{{ path('app_newsletter_subscribe') }}">
        <span class="label">Newsletter</span>
        <strong>New posts in your inbox.</strong>
        <span class="label">Subscribe →</span>
    </a>
</section>

{# The blog in numbers: rhythm, most read, reads, reading time, what's in the works, categories and who writes it.
   Only public counts; draft titles never show here. #}
{% set i = insights %}
<section class="insights" aria-labelledby="insights-heading">
    <div class="insights-head">
        <h2 id="insights-heading">Behind the blog</h2>
        <span class="mono">{% if i.last_published %}Last post {{ i.last_published|date('j M Y') }}{% else %}First post coming soon{% endif %}</span>
    </div>
    <div class="insights-grid">
        {% set peak = max(1, max(i.rhythm|map(m => m.count))) %}
        {% set year_total = i.rhythm|reduce((sum, m) => sum + m.count, 0) %}
        <div class="tile rhythm-tile">
            <span class="label">Publishing rhythm · last 12 months</span>
            <strong>{{ year_total }} post{{ year_total == 1 ? '' : 's' }} in 12 months</strong>
            <ol class="rhythm" aria-label="Posts per month">
                {% for m in i.rhythm %}
                <li style="--h: {{ (m.count / peak * 100)|round }}%"{% if m.count == 0 %} class="zero"{% endif %} data-tip="{{ m.month }}: {{ m.count }} post{{ m.count == 1 ? '' : 's' }}" tabindex="0">
                    <i aria-hidden="true"></i><span class="sr-only">{{ m.month }}: {{ m.count }} post{{ m.count == 1 ? '' : 's' }}</span><b aria-hidden="true">{{ m.label|first }}</b>
                </li>
                {% endfor %}
            </ol>
        </div>

        <div class="tile most-read">
            <span class="label">Most read</span>
            {% if i.most_read|length %}
            <ol>
                {% for post in i.most_read %}
                {% set d = post.publishedAt ?? post.createdAt %}
                <li><a href="{{ path('app_blog_post', {year: d|date('Y'), month: d|date('m'), slug: post.slug}) }}"><span class="rank mono">0{{ loop.index }}</span><strong>{{ post.title }}</strong><span class="mono">{{ post.views|number_format }} read{{ post.views == 1 ? '' : 's' }}</span></a></li>
                {% endfor %}
            </ol>
            {% elseif recent_posts|length %}
            {# No reads counted yet: show the newest instead so the tile is never empty #}
            <ol>
                {% for post in recent_posts|slice(0, 3) %}
                {% set d = post.publishedAt ?? post.createdAt %}
                <li><a href="{{ path('app_blog_post', {year: d|date('Y'), month: d|date('m'), slug: post.slug}) }}"><span class="rank mono">0{{ loop.index }}</span><strong>{{ post.title }}</strong><span class="mono">New · {{ d|date('j M Y') }}</span></a></li>
                {% endfor %}
            </ol>
            {% else %}
            <p class="muted">The most-read posts show up here once readers find them.</p>
            {% endif %}
        </div>

        <div class="tile stat-tile">
            <span class="label">Reads</span>
            <b>{{ i.reads >= 10000 ? (i.reads / 1000)|round(0) ~ 'k' : i.reads|number_format }}</b>
            <span class="label">across every post</span>
        </div>

        <div class="tile stat-tile">
            <span class="label">Reading time</span>
            <b>{{ i.read_minutes }}<small>min</small></b>
            <span class="label">to read it all</span>
        </div>

        <div class="tile categories-tile">
            <span class="label">What I write about</span>
            {% if i.categories|length %}
            <ul>
                {% for c in i.categories %}
                <li><a href="{{ path('app_blog_category', {slug: c.slug}) }}"><span>{{ c.title }}</span><span class="mono">{{ c.count }}</span></a></li>
                {% endfor %}
            </ul>
            {% elseif all_categories|length %}
            <ul>
                {% for c in all_categories|slice(0, 5) %}
                <li><a href="{{ path('app_blog_category', {slug: c.slug}) }}"><span>{{ c.title }}</span><span class="mono">soon</span></a></li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="muted">Software, technology and the lessons from shipping real products.</p>
            {% endif %}
        </div>

        <div class="tile works-tile">
            <span class="label">In the works</span>
            <b>{{ i.drafts + i.scheduled }}</b>
            <span>{{ i.drafts }} draft{{ i.drafts == 1 ? '' : 's' }} · {{ i.scheduled }} scheduled</span>
            <span class="label">{% if i.next_scheduled %}Next on {{ i.next_scheduled|date('j M') }}{% else %}Next post when it's ready{% endif %}</span>
        </div>

        <div class="tile author-tile">
            <span class="label">Who's writing</span>
            <p>Edilson Santos: full-time professional software engineer, building cool projects in his spare time and writing up what he learns.</p>
            <span class="author-meta mono">{% if i.readers > 0 %}{{ i.readers|number_format }} newsletter reader{{ i.readers == 1 ? '' : 's' }} · {% endif %}<a href="{{ path('app_newsletter_subscribe') }}">Join →</a></span>
        </div>
    </div>
</section>
{% endblock %}

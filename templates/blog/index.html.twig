{% extends 'blog/layout.html.twig' %}

{% block title %}{{ site_title }}{% endblock %}

{% block page_class %}no-sidebar{% endblock %}
{% block sidebar_wrap %}{% endblock %}

{% macro stat(label, value, unit, foot) %}
    <div class="tile stat-tile">
        <span class="label">{{ label }}</span>
        <b data-count="{{ value }}">{{ value|number_format }}{% if unit %}<small>{{ unit }}</small>{% endif %}</b>
        <span class="label">{{ foot }}</span>
    </div>
{% endmacro %}

{% block content %}
{# The landing page is one bento in the portfolio's style; every post is on the Posts page (app_blog_posts).
   Rows are 4 columns and always end flush:
     1–2  masthead (2×2) · author photo (1×2) · published (count-up) · clock ring
     3–4  only with posts: the latest post (2×2) · two side stories, or reads + reading time · currently writing (2)
     3    without posts: currently writing (2) · reads · reading time
     next newsletter (inline form) · ask me · who's writing (2)
     last topics ticker, full width
   Counts only; draft titles never show. #}
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url|trim('/', 'right') : '' %}
{% set post_total = posts is not null ? posts.totalItemCount : 0 %}
{% set recent = posts is not null ? posts|slice(0, 3) : [] %}
{% set lead = recent|first %}
{% set side = recent|slice(1, 2) %}
{% set i = insights %}
{% set in_works = i.drafts + i.scheduled %}
{% set topic_total = tag_cloud|length %}

{% import _self as cards %}

<section class="hero hero-bento" aria-label="Featured">
    <div class="tile masthead-tile">
        <span class="label">Edilson Santos · Blog</span>
        <h1>{{ site_description ?: site_title }}</h1>
        <div class="actions">
            {% if lead %}<a class="btn btn-primary" href="{{ path('app_blog_post', {year: (lead.publishedAt ?? lead.createdAt)|date('Y'), month: (lead.publishedAt ?? lead.createdAt)|date('m'), slug: lead.slug}) }}">Start reading</a>{% endif %}
            <a class="btn" href="{{ path('app_blog_posts') }}">All posts →</a>
            {% if portfolio_url %}<a class="btn" href="{{ portfolio_url }}">About me ↗</a>{% endif %}
        </div>
    </div>

    {% if portfolio_url %}
    <a class="tile photo-tile" href="{{ portfolio_url }}" aria-label="About Edilson Santos">
        <img src="{{ portfolio_url }}/avatar" alt="Portrait of Edilson Santos" width="300" height="400" loading="eager" onerror="this.remove()">
        <span class="photo-chip"><span>👋 Edilson</span><span class="mono">Writes here</span></span>
    </a>
    {% else %}
    <div class="tile about-tile photo-tile-fallback">
        <span class="label">Who's writing</span>
        <p>Edilson Santos, a full-time professional software engineer building cool projects in his spare time.</p>
    </div>
    {% endif %}

    {{ cards.stat('Published', post_total, '', 'post' ~ (post_total == 1 ? '' : 's') ~ (topic_total ? ' · ' ~ topic_total ~ ' topic' ~ (topic_total == 1 ? '' : 's') : '')) }}

    <div class="tile clock-tile">
        <span class="label">Writing from · Johannesburg</span>
        <div class="clock">
            <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="28" fill="none" stroke="var(--line)" stroke-width="5"/><circle id="clock-ring" cx="32" cy="32" r="28" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" stroke-dasharray="176" stroke-dashoffset="176"/></svg>
            <b id="clock-time">--:--</b>
        </div>
        <span class="label">SAST · UTC+2</span>
    </div>

    {% set now_card %}
    <div class="tile now-tile">
        <span class="label"><span class="dot" aria-hidden="true"></span> Currently writing</span>
        <h3>{{ in_works }} post{{ in_works == 1 ? '' : 's' }} in the works</h3>
        <span class="mono">{% if i.next_scheduled %}Next one lands {{ i.next_scheduled|date('j M') }}{% else %}{{ i.drafts }} draft{{ i.drafts == 1 ? '' : 's' }} · {{ i.scheduled }} scheduled{% endif %}</span>
    </div>
    {% endset %}
    {% set reads_card = cards.stat('Reads', i.reads, '', 'across every post') %}
    {% set minutes_card = cards.stat('Reading time', i.read_minutes, 'min', 'to read it all') %}

    {% if lead %}
    {% set lead_date = lead.publishedAt ?? lead.createdAt %}
    {% set lead_kicker = lead.category ? lead.category.title : 'Article' %}
    <a class="tile story story-lead" href="{{ path('app_blog_post', {year: lead_date|date('Y'), month: lead_date|date('m'), slug: lead.slug}) }}">
        <span class="cover-art">{% if lead.image %}<img src="{{ lead.image }}" alt="" loading="eager">{% else %}<canvas data-cover="{{ lead.title }}" data-palette="{{ lead_kicker }}" aria-hidden="true"></canvas>{% endif %}</span>
        <span class="story-kicker">Latest · {{ lead_kicker }}</span>
        <span class="story-body">
            <span class="mono">{{ lead_date|date('j M Y') }} · {{ reading_time(lead.body) }} min read</span>
            <strong>{{ lead.title }}</strong>
            <span class="story-excerpt">{{ lead.description ?: excerpt(lead.body|markdown, 160) }}</span>
        </span>
    </a>
    {% for post in side %}
    {% set post_date = post.publishedAt ?? post.createdAt %}
    {% set kicker = post.category ? post.category.title : 'Article' %}
    <a class="tile story{{ side|length == 1 ? ' wide' : '' }}" href="{{ path('app_blog_post', {year: post_date|date('Y'), month: post_date|date('m'), slug: post.slug}) }}">
        <span class="cover-art">{% if post.image %}<img src="{{ post.image }}" alt="" loading="lazy">{% else %}<canvas data-cover="{{ post.title }}" data-palette="{{ kicker }}" aria-hidden="true"></canvas>{% endif %}</span>
        <span class="story-kicker">{{ kicker }}</span>
        <span class="story-body">
            <span class="mono">{{ post_date|date('j M Y') }} · {{ reading_time(post.body) }} min</span>
            <strong>{{ post.title }}</strong>
        </span>
    </a>
    {% else %}
    {{ reads_card }}{{ minutes_card }}
    {% endfor %}
    {{ now_card }}
    {% else %}
    {{ now_card }}{{ reads_card }}{{ minutes_card }}
    {% endif %}

    <div class="tile feed-tile newsletter-tile">
        <span class="label">Newsletter</span>
        <strong>New posts in your inbox.</strong>
        <form class="inline-form" method="post" action="{{ path('app_newsletter_subscribe') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('newsletter_subscribe') }}">
            <input type="hidden" name="posts" value="1">
            <label class="sr-only" for="hero-email">Email</label>
            <input id="hero-email" type="email" name="email" autocomplete="email" maxlength="254" placeholder="you@email.com" required>
            <button type="submit">Join</button>
        </form>
    </div>

    <a class="tile ask-tile" href="{{ portfolio_url ? portfolio_url ~ '/contact' : path('app_newsletter_subscribe') }}">
        <span class="label">Topic requests</span>
        <strong>What should I write about next?</strong>
        <span class="mono">Suggest a topic →</span>
    </a>

    <div class="tile about-tile">
        <span class="label">Who's writing</span>
        <p>Edilson Santos, a full-time professional software engineer building cool projects in his spare time and writing up what he learns along the way.</p>
        <span class="mono">{% if i.readers > 0 %}{{ i.readers|number_format }} newsletter reader{{ i.readers == 1 ? '' : 's' }}{% if i.last_published %} · {% endif %}{% endif %}{% if i.last_published %}Last post {{ i.last_published|date('j M Y') }}{% elseif not i.readers %}First post in the works{% endif %}</span>
    </div>

    {% if topic_total > 0 %}
    <nav class="tile ticker-tile" aria-label="Topics">
        <span class="label">Writes about</span>
        <div class="track">
            <div class="ticker">
                {% for copy in 1..2 %}{% for item in tag_cloud|slice(0, 14) %}<a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}"{% if copy == 2 %} aria-hidden="true" tabindex="-1"{% endif %}>{{ item.tag.name }}</a>{% endfor %}{% endfor %}
            </div>
        </div>
    </nav>
    {% endif %}
</section>

<script>
(function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Clock with a seconds ring (same as the portfolio)
    var time = document.getElementById('clock-time'), ring = document.getElementById('clock-ring');
    var fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Africa/Johannesburg' });
    (function tick() { var n = new Date(); time.textContent = fmt.format(n).slice(0, 5); ring.setAttribute('stroke-dashoffset', String(176 - 176 * n.getSeconds() / 60)); setTimeout(tick, 1000); })();
    // Numbers count up; the unit (<small>) stays put
    document.querySelectorAll('.hero [data-count]').forEach(function (b) {
        var to = +b.getAttribute('data-count'), unit = b.querySelector('small');
        if (reduce || !to) return;
        var t0 = performance.now();
        (function step(t) {
            var k = Math.min(1, (t - t0) / 1200);
            b.firstChild.nodeValue = Math.round(to * (1 - Math.pow(1 - k, 3))).toLocaleString('en-US');
            if (k < 1) requestAnimationFrame(step);
        })(t0);
    });
    // A soft spotlight follows the cursor across the tiles
    var hero = document.querySelector('.hero');
    if (hero && !reduce && matchMedia('(hover: hover)').matches) {
        hero.addEventListener('pointermove', function (e) {
            hero.querySelectorAll('.tile').forEach(function (t) {
                var r = t.getBoundingClientRect();
                t.style.setProperty('--mx', (e.clientX - r.left) + 'px');
                t.style.setProperty('--my', (e.clientY - r.top) + 'px');
            });
        });
    }
})();
</script>
{% endblock %}

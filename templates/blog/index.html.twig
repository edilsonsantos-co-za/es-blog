{% extends 'blog/layout.html.twig' %}

{% block title %}{{ site_title }}{% endblock %}

{% block page_class %}no-sidebar{% endblock %}
{% block sidebar_wrap %}{% endblock %}

{% block content %}
{% set first_page = posts is null or posts.currentPageNumber == 1 %}
{% set latest = first_page and posts is not null and posts|length > 0 ? posts|first : null %}
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url : '' %}
{% set post_total = posts is not null ? posts.totalItemCount : 0 %}

{% if first_page %}
{# Cover deck: the latest posts rotate as a stack of covers. Posts without an image get generative cover art
   drawn from their title; with no posts yet, the deck shows the top topics instead. #}
{% set slides = [] %}
{% if posts is not null %}
    {% for post in posts|slice(0, 4) %}
        {% set post_date = post.publishedAt ?? post.createdAt %}
        {% set slides = slides|merge([{
            url: path('app_blog_post', {year: post_date|date('Y'), month: post_date|date('m'), slug: post.slug}),
            title: post.title,
            kicker: post.category ? post.category.title : 'Journal',
            palette: post.category ? post.category.title : 'Journal',
            meta: post_date|date('j M Y') ~ ' · ' ~ reading_time(post.body) ~ ' min',
            excerpt: post.description ?: excerpt(post.body|markdown, 160),
            image: post.image,
            cta: 'Read article →'
        }]) %}
    {% endfor %}
{% endif %}
{% if slides is empty %}
    {% for item in tag_cloud|slice(0, 4) %}
        {% set slides = slides|merge([{
            url: path('app_blog_tag', {slug: item.tag.slug}),
            title: '#' ~ item.tag.name,
            kicker: 'Topic',
            palette: item.tag.name,
            meta: item.postCount > 0 ? item.postCount ~ ' post' ~ (item.postCount == 1 ? '' : 's') : 'First posts coming soon',
            excerpt: 'Everything written under #' ~ item.tag.name ~ ', newest first.',
            image: null,
            cta: 'Browse topic →'
        }]) %}
    {% endfor %}
{% endif %}
{% set first = slides|first %}
<section class="hero hero-deck{{ first ? '' : ' hero-solo' }}" aria-label="Featured" data-deck>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="hero-copy">
        <span class="label" data-deck-label>The journal · {{ post_total }} post{{ post_total == 1 ? '' : 's' }}{% if first %} · {{ first.kicker }}{% endif %}</span>
        <h1 data-deck-title>{{ first ? first.title : (site_description ?: site_title) }}</h1>
        <p class="hero-by" data-deck-excerpt>{{ first ? first.excerpt : 'Written by ' ~ site_title ~ '.' }}</p>
        <div class="actions">
            {% if first %}<a class="btn btn-primary" href="{{ first.url }}" data-deck-cta>{{ first.cta }}</a>{% endif %}
            <a class="btn" href="{{ path('app_blog_feed') }}">Subscribe via RSS</a>
            {% if portfolio_url %}<a class="btn" href="{{ portfolio_url }}">About me ↗</a>{% endif %}
        </div>
        {% if slides|length > 1 %}
        <div class="deck-nav" role="group" aria-label="Featured items">
            {% for slide in slides %}<button type="button" aria-label="Show {{ slide.title }}"{{ loop.first ? ' aria-current="true"' : '' }}></button>{% endfor %}
        </div>
        {% endif %}
    </div>

    {% if first %}
    <div class="deck">
        {% for slide in slides %}
        <a class="cover" href="{{ slide.url }}"{{ loop.first ? '' : ' tabindex="-1"' }}
           data-title="{{ slide.title }}" data-kicker="{{ slide.kicker }}" data-palette="{{ slide.palette }}" data-excerpt="{{ slide.excerpt }}" data-cta="{{ slide.cta }}">
            <span class="cover-art">
                {% if slide.image %}<img src="{{ slide.image }}" alt="" loading="{{ loop.first ? 'eager' : 'lazy' }}">{% else %}<canvas aria-hidden="true"></canvas>{% endif %}
            </span>
            <span class="cover-kicker">{{ slide.kicker }}</span>
            <span class="cover-body">
                <span class="mono">{{ slide.meta }}</span>
                <strong>{{ slide.title }}</strong>
            </span>
        </a>
        {% endfor %}
    </div>
    <script src="{{ asset('assets/blog/cover-deck.js') }}" defer></script>
    {% endif %}
</section>

{% if tag_cloud|length > 0 %}
<nav class="topics-strip" aria-label="Topics">
    <span class="label">Topics</span>
    <div class="topics-scroll">
        {% for item in tag_cloud %}
        <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">#{{ item.tag.name }} <span class="tag-count">{{ item.postCount }}</span></a>
        {% endfor %}
    </div>
</nav>
{% endif %}
{% endif %}

<section class="list-head" aria-labelledby="latest-posts-heading">
    <h2 id="latest-posts-heading">{{ first_page ? 'All writing' : 'All writing · page ' ~ posts.currentPageNumber }}</h2>
    <a class="list-head-link" href="{{ path('app_blog_feed') }}">RSS</a>
</section>

{% include 'blog/_post_list.html.twig' with {posts: posts, route: 'app_blog_index', route_params: {}} %}
{% endblock %}

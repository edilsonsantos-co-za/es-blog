78.787-.212 1.074-.518.455-.488.546-1.124.385-1.766zm-1.478.772c-.145.137-.363.201-.578.233-2.416.359-4.866.54-7.308.46-1.748-.06-3.477-.254-5.207-.498-.17-.024-.353-.055-.47-.18-.22-.236-.111-.71-.054-.995.052-.26.152-.609.463-.646.484-.057 1.046.148 1.526.22.577.088 1.156.159 1.737.212 2.48.226 5.002.19 7.472-.14.45-.06.899-.13 1.345-.21.399-.072.84-.206 1.08.206.166.281.188.657.162.974a.544.544 0 01-.169.364zm-6.159 3.9c-.862.37-1.84.788-3.109.788a5.884 5.884 0 01-1.569-.217l.877 9.004c.065.78.717 1.38 1.5 1.38 0 0 1.243.065 1.658.065.447 0 1.786-.065 1.786-.065.783 0 1.434-.6 1.499-1.38l.94-9.95a3.996 3.996 0 00-1.322-.238c-.826 0-1.491.284-2.26.613z"/></svg>Buy me a coffee</a>
    </aside>
    {% endif %}

    <div class="author-box">
        {% if avatar_url(post.author) %}
        <img src="{{ avatar_url(post.author, 160) }}" alt="{{ post.author.displayName }}" class="author-avatar">
        {% else %}
        <div class="author-avatar author-avatar-fallback" aria-hidden="true">{{ post.author.displayName|first|upper }}</div>
        {% endif %}
        <div class="author-info">
            <p class="author-label">Written by</p>
            <h2 class="author-name">
                <a href="{{ path('app_blog_author', {username: post.author.username}) }}">{{ post.author.displayName }}</a>
            </h2>
            {% if post.author.about %}
            <p class="author-bio">{{ post.author.about }}</p>
            {% endif %}
            <div class="author-social">
                {% if post.author.twitter %}<a href="{{ post.author.twitter }}" rel="noopener noreferrer" target="_blank">Twitter</a>{% endif %}
                {% if post.author.github %}<a href="{{ post.author.github }}" rel="noopener noreferrer" target="_blank">GitHub</a>{% endif %}
                {% if post.author.linkedin %}<a href="{{ post.author.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>{% endif %}
                {% if post.author.bluesky %}<a href="{{ post.author.bluesky }}" rel="noopener noreferrer" target="_blank">Bluesky</a>{% endif %}
            </div>
        </div>
    </div>
</article>

<nav class="post-navigation" aria-label="Post navigation">
    {% if prev %}
    <a class="post-nav-card post-nav-prev" href="{{ path('app_blog_post', {
        year: (prev.publishedAt ?? prev.createdAt)|date('Y'),
        month: (prev.publishedAt ?? prev.createdAt)|date('m'),
        slug: prev.slug
    }) }}">
        <span>Previous</span>
        <strong>{{ prev.title }}</strong>
    </a>
    {% endif %}
    {% if next %}
    <a class="post-nav-card post-nav-next" href="{{ path('app_blog_post', {
        year: (next.publishedAt ?? next.createdAt)|date('Y'),
        month: (next.publishedAt ?? next.createdAt)|date('m'),
        slug: next.slug
    }) }}">
        <span>Next</span>
        <strong>{{ next.title }}</strong>
    </a>
    {% endif %}
</nav>
{% endblock %}

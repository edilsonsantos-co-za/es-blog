{% extends 'blog/layout.html.twig' %}

{% block title %}{{ post.title }} — {{ site_title }}{% endblock %}

{% block meta_description %}
<meta name="description" content="{{ post.description ?? excerpt(post.body, 160) }}">
{% endblock %}

{% block canonical %}
<link rel="canonical" href="{{ url('app_blog_post', {
    year: (post.publishedAt ?? post.createdAt)|date('Y'),
    month: (post.publishedAt ?? post.createdAt)|date('m'),
    slug: post.slug
}) }}">
{% endblock %}

{% block opengraph %}
<meta property="og:site_name" content="{{ site_title }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ post.title }}">
<meta property="og:description" content="{{ post.description ?? excerpt(post.body, 160) }}">
<meta property="og:url" content="{{ url('app_blog_post', {
    year: (post.publishedAt ?? post.createdAt)|date('Y'),
    month: (post.publishedAt ?? post.createdAt)|date('m'),
    slug: post.slug
}) }}">
{% if post.image %}
{# Absolute URLs: LinkedIn, X and other link previews ignore relative images #}
{% set share_image = post.image starts with '/' ? absolute_url(post.image) : post.image %}
<meta property="og:image" content="{{ share_image }}">
<meta property="og:image:alt" content="{{ post.title }}">
{% if post.image starts with '/uploads/banners/' %}<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ share_image }}">
<meta name="twitter:image:alt" content="{{ post.title }}">
{% else %}
<meta name="twitter:card" content="summary">
{% endif %}
<meta name="twitter:title" content="{{ post.title }}">
<meta name="twitter:description" content="{{ post.description ?? excerpt(post.body, 160) }}">
<meta property="article:published_time" content="{{ (post.publishedAt ?? post.createdAt)|date('c') }}">
<meta property="article:author" content="{{ post.author.username }}">
{% endblock %}

{% block content %}
<article class="single-post">
    <header class="post-header">
        <div class="post-kicker-row">
            {% if post.category %}
            <a class="post-category" href="{{ path('app_blog_category', {slug: post.category.slug}) }}">
                {{ post.category.title }}
            </a>
            {% endif %}
            <span>{{ reading_time(post.body) }} min read</span>
        </div>

        <h1 class="post-title">{{ post.title }}</h1>

        <div class="post-meta post-meta-large">
            <span class="post-author">By <a href="{{ path('app_blog_author', {username: post.author.username}) }}">{{ post.author.username }}</a></span>
            <time datetime="{{ (post.publishedAt ?? post.createdAt)|date('c') }}">{{ (post.publishedAt ?? post.createdAt)|date('F j, Y') }}</time>
            <span class="post-views">{{ post.views }} views</span>
        </div>

        {% if post.description %}
        <p class="post-dek">{{ post.description }}</p>
        {% endif %}

        {% if post.image %}
        <div class="post-cover">
            <img src="{{ post.image }}" alt="{{ post.title }}">
        </div>
        {% endif %}
    </header>

    <div class="post-body">
        {{ post.body|markdown }}
    </div>

    {% if post.tags|length > 0 %}
    <div class="post-tags">
        <span>Filed under</span>
        {% for tag in post.tags %}
        <a href="{{ path('app_blog_tag', {slug: tag.slug}) }}" class="tag-pill">{{ tag.name }}</a>
        {% endfor %}
    </div>
    {% endif %}

    {% if site_coffee_url %}
    <aside class="post-support" aria-label="Support this writing">
        <div>
            <strong>Found this useful?</strong>
            <span>Posts here are written in spare time. A coffee keeps them coming.</span>
        </div>
        <a class="btn coffee" href="{{ site_coffee_url }}" target="_blank" rel="noopener"><svg class="coffee-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3v3M12 3v3"/></svg>Buy me a coffee</a>
    </aside>
    {% endif %}

    <div class="author-box">
        {% if avatar_url(post.author) %}
        <img src="{{ avatar_url(post.author, 160) }}" alt="{{ post.author.username }}" class="author-avatar">
        {% else %}
        <div class="author-avatar author-avatar-fallback" aria-hidden="true">{{ post.author.username|first|upper }}</div>
        {% endif %}
        <div class="author-info">
            <p class="author-label">Written by</p>
            <h2 class="author-name">
                <a href="{{ path('app_blog_author', {username: post.author.username}) }}">{{ post.author.username }}</a>
            </h2>
            {% if post.author.about %}
            <p class="author-bio">{{ post.author.about }}</p>
            {% endif %}
            <div class="author-social">
                {% if post.author.twitter %}<a href="{{ post.author.twitter }}" rel="noopener noreferrer" target="_blank">Twitter</a>{% endif %}
                {% if post.author.github %}<a href="{{ post.author.github }}" rel="noopener noreferrer" target="_blank">GitHub</a>{% endif %}
                {% if post.author.linkedin %}<a href="{{ post.author.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>{% endif %}
                {% if post.author.bluesky %}<a href="{{ post.author.bluesky }}" rel="noopener noreferrer" target="_blank">Bluesky</a>{% endif %}
            </div>
        </div>
    </div>
</article>

<nav class="post-navigation" aria-label="Post navigation">
    {% if prev %}
    <a class="post-nav-card post-nav-prev" href="{{ path('app_blog_post', {
        year: (prev.publishedAt ?? prev.createdAt)|date('Y'),
        month: (prev.publishedAt ?? prev.createdAt)|date('m'),
        slug: prev.slug
    }) }}">
        <span>Previous</span>
        <strong>{{ prev.title }}</strong>
    </a>
    {% endif %}
    {% if next %}
    <a class="post-nav-card post-nav-next" href="{{ path('app_blog_post', {
        year: (next.publishedAt ?? next.createdAt)|date('Y'),
        month: (next.publishedAt ?? next.createdAt)|date('m'),
        slug: next.slug
    }) }}">
        <span>Next</span>
        <strong>{{ next.title }}</strong>
    </a>
    {% endif %}
</nav>
{% endblock %}

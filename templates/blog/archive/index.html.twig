{% extends 'blog/layout.html.twig' %}

{% set archive_month = month ? (month < 10 ? '0' ~ month : month) : null %}
{% set heading = month ? "Archive: #{year}/#{archive_month}" : "Archive: #{year}" %}

{% block title %}{{ heading }} — {{ site_title }}{% endblock %}

{% block content %}
<header class="archive-header">
    <p class="archive-eyebrow">Archive</p>
    <h1>{{ heading }}</h1>
    <p class="archive-description">A chronological view of published posts from this period.</p>
</header>

{% set route_params = month ? {year: year, month: month} : {year: year} %}
{% set route_name = month ? 'app_blog_archive_month' : 'app_blog_archive_year' %}
{% include 'blog/_post_list.html.twig' with {posts: posts, route: route_name, route_params: route_params} %}
{% endblock %}

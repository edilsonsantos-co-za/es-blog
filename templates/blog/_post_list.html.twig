<div class="post-list">
    {% for post in posts %}
    <article class="post-card">
        {% if post.image %}
        <div class="post-card-image">
            <a href="{{ path('app_blog_post', {
                year: (post.publishedAt ?? post.createdAt)|date('Y'),
                month: (post.publishedAt ?? post.createdAt)|date('m'),
                slug: post.slug
            }) }}">
                <img src="{{ post.image }}" alt="{{ post.title }}">
            </a>
        </div>
        {% endif %}

        <div class="post-card-body">
            <header class="post-card-header">
                {% if post.category %}
                <a class="post-category" href="{{ path('app_blog_category', {slug: post.category.slug}) }}">
                    {{ post.category.title }}
                </a>
                {% endif %}
                <h2 class="post-card-title">
                    <a href="{{ path('app_blog_post', {
                        year: (post.publishedAt ?? post.createdAt)|date('Y'),
                        month: (post.publishedAt ?? post.createdAt)|date('m'),
                        slug: post.slug
                    }) }}">{{ post.title }}</a>
                </h2>
                <div class="post-meta">
                    <span class="post-author">
                        by <a href="{{ path('app_blog_author', {username: post.author.username}) }}">{{ post.author.username }}</a>
                    </span>
                    <span class="post-date">{{ (post.publishedAt ?? post.createdAt)|date('F j, Y') }}</span>
                    <span class="post-reading-time">{{ reading_time(post.body) }} min read</span>
                </div>
            </header>

            <div class="post-card-excerpt">
                <p>{{ excerpt(post.body, 200) }}</p>
            </div>

            {% if post.tags|length > 0 %}
            <div class="post-card-tags">
                {% for tag in post.tags %}
                <a href="{{ path('app_blog_tag', {slug: tag.slug}) }}" class="tag-pill">{{ tag.name }}</a>
                {% endfor %}
            </div>
            {% endif %}

            <a class="read-more" href="{{ path('app_blog_post', {
                year: (post.publishedAt ?? post.createdAt)|date('Y'),
                month: (post.publishedAt ?? post.createdAt)|date('m'),
                slug: post.slug
            }) }}">Read more →</a>
        </div>
    </article>
    {% else %}
    <p class="no-posts">No posts found.</p>
    {% endfor %}
</div>

{% if posts is not null and posts.pageCount > 1 %}
<nav class="pagination" aria-label="Pagination">
    {% if posts.currentPageNumber > 1 %}
    <a href="{{ path(route, route_params|merge({page: posts.currentPageNumber - 1})) }}" class="pagination-prev">← Previous</a>
    {% endif %}

    {% for p in 1..posts.pageCount %}
    {% if p == posts.currentPageNumber %}
    <span class="pagination-current">{{ p }}</span>
    {% else %}
    <a href="{{ path(route, route_params|merge({page: p})) }}" class="pagination-page">{{ p }}</a>
    {% endif %}
    {% endfor %}

    {% if posts.currentPageNumber < posts.pageCount %}
    <a href="{{ path(route, route_params|merge({page: posts.currentPageNumber + 1})) }}" class="pagination-next">Next →</a>
    {% endif %}
</nav>
{% endif %}

<div class="post-list">
    {% for post in posts %}
    <article class="post-card">
        {% if post.image %}
        <a class="post-card-media" href="{{ path('app_blog_post', {
            year: (post.publishedAt ?? post.createdAt)|date('Y'),
            month: (post.publishedAt ?? post.createdAt)|date('m'),
            slug: post.slug
        }) }}" aria-label="Read {{ post.title }}">
            <img src="{{ post.image }}" alt="{{ post.title }}">
        </a>
        {% else %}
        <a class="post-card-media post-card-placeholder" href="{{ path('app_blog_post', {
            year: (post.publishedAt ?? post.createdAt)|date('Y'),
            month: (post.publishedAt ?? post.createdAt)|date('m'),
            slug: post.slug
        }) }}" aria-label="Read {{ post.title }}">
            <span>{{ post.category ? post.category.title : site_title }}</span>
        </a>
        {% endif %}

        <div class="post-card-body">
            <header class="post-card-header">
                <div class="post-card-kicker">
                    {% if post.category %}
                    <a class="post-category" href="{{ path('app_blog_category', {slug: post.category.slug}) }}">
                        {{ post.category.title }}
                    </a>
                    {% endif %}
                    <span>{{ reading_time(post.body) }} min read</span>
                </div>
                <h2 class="post-card-title">
                    <a href="{{ path('app_blog_post', {
                        year: (post.publishedAt ?? post.createdAt)|date('Y'),
                        month: (post.publishedAt ?? post.createdAt)|date('m'),
                        slug: post.slug
                    }) }}">{{ post.title }}</a>
                </h2>
                <div class="post-meta">
                    <span class="post-author">By <a href="{{ path('app_blog_author', {username: post.author.username}) }}">{{ post.author.username }}</a></span>
                    <time datetime="{{ (post.publishedAt ?? post.createdAt)|date('c') }}">{{ (post.publishedAt ?? post.createdAt)|date('F j, Y') }}</time>
                </div>
            </header>

            <p class="post-card-excerpt">{{ excerpt(post.body|markdown, 220) }}</p>

            <footer class="post-card-footer">
                {% if post.tags|length > 0 %}
                <div class="post-card-tags" aria-label="Post tags">
                    {% for tag in post.tags|slice(0, 4) %}
                    <a href="{{ path('app_blog_tag', {slug: tag.slug}) }}" class="tag-pill">{{ tag.name }}</a>
                    {% endfor %}
                </div>
                {% endif %}

                <a class="read-more" href="{{ path('app_blog_post', {
                    year: (post.publishedAt ?? post.createdAt)|date('Y'),
                    month: (post.publishedAt ?? post.createdAt)|date('m'),
                    slug: post.slug
                }) }}">Continue reading</a>
            </footer>
        </div>
    </article>
    {% else %}
    <div class="empty-state">
        <p class="empty-state-eyebrow">Nothing to show yet</p>
        <h2>No posts found</h2>
        <p>Try a different search, browse the latest posts, or check back soon for new writing.</p>
        <div class="empty-state-actions">
            <a class="btn btn-primary" href="{{ path('app_blog_index') }}">Browse latest posts</a>
            <a class="btn btn-secondary" href="{{ path('app_blog_search') }}">Search again</a>
        </div>
    </div>
    {% endfor %}
</div>

{% if posts is not null and posts.pageCount > 1 %}
<nav class="pagination" aria-label="Pagination">
    {% if posts.currentPageNumber > 1 %}
    <a href="{{ path(route, route_params|merge({page: posts.currentPageNumber - 1})) }}" class="pagination-prev">← Previous</a>
    {% endif %}

    {% for p in 1..posts.pageCount %}
    {% if p == posts.currentPageNumber %}
    <span class="pagination-current" aria-current="page">{{ p }}</span>
    {% else %}
    <a href="{{ path(route, route_params|merge({page: p})) }}" class="pagination-page">{{ p }}</a>
    {% endif %}
    {% endfor %}

    {% if posts.currentPageNumber < posts.pageCount %}
    <a href="{{ path(route, route_params|merge({page: posts.currentPageNumber + 1})) }}" class="pagination-next">Next →</a>
    {% endif %}
</nav>
{% endif %}

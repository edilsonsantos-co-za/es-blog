{% extends 'blog/layout.html.twig' %}

{% block title %}Category: {{ category.title }} — {{ site_title }}{% endblock %}

{% block content %}
<header class="archive-header taxonomy-header">
    <p class="archive-eyebrow">Category</p>
    <h1>{{ category.title }}</h1>
    {% if category.description %}
    <p class="archive-description">{{ category.description }}</p>
    {% else %}
    <p class="archive-description">Posts grouped under {{ category.title }}.</p>
    {% endif %}
</header>

{% include 'blog/_post_list.html.twig' with {posts: posts, route: 'app_blog_category', route_params: {slug: category.slug}} %}
{% endblock %}

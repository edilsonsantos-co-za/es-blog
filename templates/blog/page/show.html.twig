{% extends 'blog/layout.html.twig' %}

{% block title %}{{ post.title }} — {{ site_title }}{% endblock %}

{% block meta_description %}
<meta name="description" content="{{ post.description ?? excerpt(post.body, 160) }}">
{% endblock %}

{% block canonical %}
<link rel="canonical" href="{{ url('app_blog_page', {slug: post.slug}) }}">
{% endblock %}

{% block opengraph %}
<meta property="og:site_name" content="{{ site_title }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ post.title }}">
<meta property="og:description" content="{{ post.description ?? excerpt(post.body, 160) }}">
<meta property="og:url" content="{{ url('app_blog_page', {slug: post.slug}) }}">
{% if post.image %}
<meta property="og:image" content="{{ post.image }}">
{% endif %}
{% endblock %}

{% block content %}
<article class="static-page">
    <header class="page-header">
        <p class="archive-eyebrow">Page</p>
        <h1 class="page-title">{{ post.title }}</h1>
        {% if post.description %}<p class="page-description">{{ post.description }}</p>{% endif %}
    </header>

    {% if post.image %}
    <div class="post-cover page-cover">
        <img src="{{ post.image }}" alt="{{ post.title }}">
    </div>
    {% endif %}

    <div class="post-body">
        {{ post.body|markdown }}
    </div>
</article>
{% endblock %}

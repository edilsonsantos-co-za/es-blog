{% extends 'newsletter/_layout.html.twig' %}
{% block title %}Confirm newsletter · {{ site_title }}{% endblock %}
{% block kicker %}Newsletter · {% if confirmed %}confirmed{% else %}confirm{% endif %}{% endblock %}
{% block heading %}{% if confirmed %}You're in.{% elseif subscriber %}One last step.{% else %}This link has expired.{% endif %}{% endblock %}
{% block lead %}<p>{% if confirmed %}Your subscription is confirmed, and a welcome email is on its way.{% elseif subscriber %}Confirm below and your choices start right away.{% else %}It's invalid, already used or expired. Ask for a new one and it arrives in a minute.{% endif %}</p>{% endblock %}
{% block form %}
<div class="contact-form">
{% if subscriber and (confirmed or not subscriber.confirmedAt) %}
    <ul class="picked" aria-label="{% if confirmed %}You'll get{% else %}You asked for{% endif %}">
        {% if subscriber.posts %}<li><b>New blog posts</b><small>When a new post goes live.</small></li>{% endif %}
        {% if subscriber.products %}<li><b>ES product and release updates</b><small>New apps, themes and releases.</small></li>{% endif %}
    </ul>
{% endif %}
{% if confirmed %}
    <div class="actions"><a class="btn btn-primary primary" href="{{ path('app_blog_posts') }}">Read the latest posts</a></div>
{% elseif subscriber %}
    <form method="post"><input type="hidden" name="_token" value="{{ csrf_token('newsletter_confirm') }}"><button class="btn btn-primary primary" type="submit">Confirm my subscription</button></form>
{% else %}
    <div class="actions"><a class="btn btn-primary primary" href="{{ path('app_newsletter_subscribe') }}">Request a new confirmation</a></div>
{% endif %}
</div>
{% endblock %}
{% block promise %}
{% if confirmed %}
<ul class="promise">
    <li>Change your choices from the link in any email</li>
    <li>Unsubscribe from any email, in one click</li>
</ul>
{% else %}{{ parent() }}{% endif %}
{% endblock %}

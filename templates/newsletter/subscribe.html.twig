{% extends 'blog/layout.html.twig' %}
{% block title %}Newsletter{% endblock %}
{% block content %}
<section class="panel">
<h1>ES Blog newsletter</h1>
<p>Choose only what you want. No account required. Confirm by email before receiving updates; unsubscribe in every email.</p>
{% if not ready %}<p role="status">Email subscriptions are temporarily unavailable. No confirmation is being sent. Please try again later.</p>{% endif %}
{% if message %}<p role="status">{{ message }}</p>{% endif %}
<form method="post">
<input type="hidden" name="_token" value="{{ csrf_token('newsletter_subscribe') }}">
<p><label for="newsletter-email">Email address</label><br><input id="newsletter-email" type="email" name="email" autocomplete="email" maxlength="254" required></p>
<p><label><input type="checkbox" name="posts" value="1"> Email me new blog posts</label></p>
<p><label><input type="checkbox" name="products" value="1"> Email me ES product and release updates</label></p>
<button type="submit" {% if not ready %}disabled{% endif %}>Request confirmation</button>
</form>
</section>
{% endblock %}

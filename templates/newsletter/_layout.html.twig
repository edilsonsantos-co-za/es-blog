{# Newsletter pages: one lead card. Heading and lead, then the form or result, then the promises as a footer strip. #}
{% extends 'blog/layout.html.twig' %}
{% block page_class %}no-sidebar{% endblock %}
{% block sidebar_wrap %}{% endblock %}
{% block content %}
<section class="contact newsletter">
    <div class="tile cta">
        <header class="nl-head">
            <span class="mono">{% block kicker %}Newsletter{% endblock %}</span>
            <h1>{% block heading %}{% endblock %}</h1>
            {% block lead %}{% endblock %}
        </header>
        {% block form %}{% endblock %}
        {% block promise %}
        <ul class="promise">
            <li>No account needed</li>
            <li>Nothing starts until you confirm by email</li>
            <li>Unsubscribe from any email, in one click</li>
        </ul>
        {% endblock %}
    </div>
</section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block body_class %}atlas-auth-body{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Manrope:wght@500;600;700;800&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/solid.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/adminlte.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/atlas-auth.css') }}">
{% endblock %}

{% block body %}
<div class="atlas-auth">
    <header class="atlas-auth-top">
        <a href="{{ path('app_blog_index') }}" class="atlas-auth-brand">
            {% if site_logo %}
            <span class="atlas-auth-logo has-img" aria-hidden="true"><img src="{{ site_logo }}" alt=""></span>
            {% else %}
            <span class="atlas-auth-logo" aria-hidden="true">{{ site_title|default('EdFolio Blog')|first|upper }}</span>
            {% endif %}
            <span class="atlas-auth-brand-text">
                <b>{{ site_title|default('EdFolio Blog') }}</b>
                <span class="mono">Blog admin</span>
            </span>
        </a>
        <div class="atlas-auth-actions">
            <a class="atlas-auth-link-btn" href="{{ path('app_blog_index') }}">← <span>Back to blog</span></a>
        </div>
    </header>

    <main class="atlas-auth-main">
        <div class="atlas-auth-card">
            {% block auth_content %}{% endblock %}
        </div>
    </main>

    <footer class="atlas-auth-foot mono">
        <span>&copy; {{ "now"|date("Y") }} {{ site_title|default('EdFolio Blog') }}</span>
        {% if app_release_tag is defined %}<span>{{ app_release_tag }}</span>{% endif %}
    </footer>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/admin/js/jquery.min.js') }}" defer></script>
    <script src="{{ asset('assets/admin/js/adminlte.min.js') }}" defer></script>
{% endblock %}

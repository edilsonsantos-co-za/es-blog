{% extends 'base.html.twig' %}

{% block body_class %}auth-page{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/admin/css/source-sans.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/solid.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/adminlte.min.css') }}">
    <style>
        :root {
            --auth-bg: #f5f6f8;
            --auth-surface: rgba(255, 255, 255, .92);
            --auth-surface-strong: #ffffff;
            --auth-ink: #1f2937;
            --auth-ink-strong: #111827;
            --auth-muted: #667085;
            --auth-border: rgba(31, 41, 55, .12);
            --auth-accent: #2563eb;
            --auth-accent-strong: #1d4ed8;
            --auth-hero-bg: #111827;
            --auth-hero-soft: #1f2937;
            --auth-radius: 1rem;
            --auth-shadow: 0 18px 45px rgba(17, 24, 39, .08);
        }

        *, *::before, *::after { box-sizing: border-box; }

        .auth-page {
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
            background: var(--auth-bg);
            color: var(--auth-ink);
            font-family: "Source Sans Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .auth-shell {
            position: relative;
            z-index: 1;
            display: grid;
            place-items: center;
            min-height: 100vh;
            padding: clamp(1rem, 3vw, 2rem);
        }

        .auth-panel {
            display: grid;
            grid-template-columns: minmax(0, .95fr) minmax(360px, .85fr);
            width: min(1040px, 100%);
            overflow: hidden;
            border: 1px solid var(--auth-border);
            border-radius: var(--auth-radius);
            background: var(--auth-surface-strong);
            box-shadow: var(--auth-shadow);
        }

        .auth-hero {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            gap: clamp(3rem, 8vw, 6rem);
            min-height: 560px;
            padding: clamp(2rem, 5vw, 3.5rem);
            background: var(--auth-hero-bg);
            color: #fff;
        }

        .auth-hero::after {
            display: none;
        }

        .auth-brand,
        .auth-brand:hover {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            gap: .85rem;
            color: #fff;
            text-decoration: none;
        }

        .auth-mark {
            display: inline-grid;
            place-items: center;
            width: 3rem;
            height: 3rem;
            border-radius: .95rem;
            background: var(--auth-accent);
            border: 1px solid rgba(255, 255, 255, .2);
        }

        .auth-brand-title {
            display: block;
            font-size: 1.2rem;
            font-weight: 900;
            letter-spacing: -.035em;
            line-height: 1;
        }

        .auth-brand-subtitle {
            display: block;
            margin-top: .2rem;
            color: rgba(255, 255, 255, .68);
            font-size: .8rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .auth-hero-copy {
            position: relative;
            z-index: 1;
            max-width: 34rem;
        }

        .auth-eyebrow,
        .auth-login-eyebrow {
            margin: 0 0 .75rem;
            font-size: .78rem;
            font-weight: 900;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        .auth-eyebrow { color: rgba(255, 255, 255, .68); }

        .auth-hero h1 {
            margin: 0;
            max-width: 12ch;
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 900;
            line-height: .95;
            letter-spacing: -.06em;
        }

        .auth-hero p:not(.auth-eyebrow) {
            max-width: 30rem;
            margin: 1.25rem 0 0;
            color: rgba(255, 255, 255, .78);
            font-size: clamp(1rem, 1.7vw, 1.18rem);
            line-height: 1.65;
        }

        .auth-proof {
            position: relative;
            z-index: 1;
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .auth-proof li {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .55rem .75rem;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 999px;
            background: rgba(255, 255, 255, .09);
            color: rgba(255, 255, 255, .82);
            font-weight: 800;
            font-size: .88rem;
        }

        .auth-card-wrap {
            display: grid;
            align-content: center;
            padding: clamp(1.3rem, 4vw, 3rem);
            background: var(--auth-surface-strong);
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
            padding: clamp(1.45rem, 4vw, 2.2rem);
            border: 1px solid var(--auth-border);
            border-radius: var(--auth-radius);
            background: var(--auth-surface-strong);
            box-shadow: none;
        }

        .auth-card-header { margin-bottom: 1.45rem; }

        .auth-login-eyebrow { color: var(--auth-accent); }

        .auth-card-title {
            margin: 0;
            color: var(--auth-ink-strong);
            font-size: clamp(1.85rem, 4vw, 2.35rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -.045em;
        }

        .auth-card-subtitle,
        .login-box-msg {
            margin: .85rem 0 0;
            color: var(--auth-muted);
            font-size: 1rem;
            line-height: 1.55;
        }

        .auth-form { display: grid; gap: 1rem; }

        .auth-field { display: grid; gap: .45rem; }

        .auth-label {
            margin: 0;
            color: var(--auth-ink-strong);
            font-size: .83rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .auth-input-shell {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            min-height: 3.35rem;
            border: 1px solid var(--auth-border);
            border-radius: .75rem;
            background: #f9fafb;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }

        .auth-input-shell:focus-within {
            border-color: rgba(37, 99, 235, .42);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .12);
        }

        .auth-input {
            width: 100%;
            min-width: 0;
            height: 3.25rem;
            padding: .85rem 1rem;
            color: var(--auth-ink);
            border: 0;
            outline: 0;
            background: transparent;
            font: inherit;
            font-weight: 700;
        }

        .auth-input::placeholder { color: #9aa39c; font-weight: 600; }

        .auth-input-icon {
            display: inline-grid;
            place-items: center;
            width: 3.2rem;
            color: var(--auth-accent);
        }

        .auth-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .15rem;
        }

        .auth-check {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            margin: 0;
            color: var(--auth-muted);
            font-weight: 800;
            cursor: pointer;
        }

        .auth-check input {
            width: 1.05rem;
            height: 1.05rem;
            accent-color: var(--auth-accent);
        }

        .auth-submit,
        .auth-card .btn-primary,
        .auth-card .btn-success {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .55rem;
            width: 100%;
            min-height: 3.25rem;
            padding: .85rem 1rem;
            border: 0;
            border-radius: .75rem;
            color: #fff;
            background: var(--auth-accent);
            box-shadow: 0 16px 34px rgba(37, 99, 235, .20);
            font: inherit;
            font-weight: 900;
            cursor: pointer;
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .auth-submit:hover,
        .auth-card .btn-primary:hover,
        .auth-card .btn-success:hover {
            color: #fff;
            transform: translateY(-1px);
            background: var(--auth-accent-strong);
            box-shadow: 0 20px 42px rgba(37, 99, 235, .24);
        }

        .auth-sso {
            text-decoration: none;
        }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin: 1.1rem 0;
            color: var(--auth-muted);
            font-size: .85rem;
            font-weight: 700;
        }

        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--auth-border);
        }

        .auth-alert,
        .auth-card .alert {
            margin: 0 0 1rem;
            padding: .9rem 1rem;
            border: 1px solid rgba(220, 38, 38, .22);
            border-radius: 16px;
            background: #fff1f2;
            color: #9f1239;
            font-weight: 800;
        }

        .auth-alert .close {
            float: right;
            margin: -.2rem -.2rem 0 .75rem;
            color: inherit;
            opacity: .7;
        }

        .auth-card a { color: var(--auth-accent); font-weight: 800; }
        .auth-card hr { border-top-color: var(--auth-border); }
        .auth-card code { color: var(--auth-accent-strong); }

        .auth-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 1.35rem;
            color: var(--auth-muted);
            font-size: .85rem;
            font-weight: 700;
        }

        .auth-footer a { color: var(--auth-muted); text-decoration: none; }
        .auth-footer a:hover { color: var(--auth-accent); }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        @media (max-width: 900px) {
            .auth-panel { grid-template-columns: 1fr; }
            .auth-hero { min-height: auto; gap: 2rem; }
            .auth-hero h1 { max-width: 12ch; }
        }

        @media (max-width: 560px) {
            .auth-shell { padding: .75rem; }
            .auth-panel,
            .auth-card { border-radius: 20px; }
            .auth-hero,
            .auth-card-wrap,
            .auth-card { padding: 1.25rem; }
            .auth-proof { display: none; }
            .auth-footer { flex-direction: column; align-items: flex-start; }
        }
    </style>
{% endblock %}

{% block body %}
<main class="auth-shell">
    <div class="auth-panel">
        <section class="auth-hero" aria-label="EdFolio Blog publishing workspace">
            <a href="{{ path('app_blog_index') }}" class="auth-brand">
                <span class="auth-mark" aria-hidden="true"><i class="fas fa-pen-nib"></i></span>
                <span>
                    <span class="auth-brand-title">{{ site_title|default('EdFolio Blog') }}</span>
                    <span class="auth-brand-subtitle">Admin workspace</span>
                </span>
            </a>

            <div class="auth-hero-copy">
                <p class="auth-eyebrow">Secure editorial access</p>
                <h1>Shape the next story.</h1>
                <p>Sign in to manage articles, pages, authors, releases, and the publishing rhythm behind the public journal.</p>
            </div>

            <ul class="auth-proof" aria-label="Admin capabilities">
                <li><i class="fas fa-shield-alt" aria-hidden="true"></i> Protected access</li>
                <li><i class="fas fa-feather-alt" aria-hidden="true"></i> Editorial tools</li>
                <li><i class="fas fa-chart-line" aria-hidden="true"></i> Publishing insights</li>
            </ul>
        </section>

        <section class="auth-card-wrap" aria-label="Authentication form">
            <div class="auth-card">
                {% block auth_content %}{% endblock %}

                <div class="auth-footer">
                    <a href="{{ path('app_blog_index') }}"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to site</a>
                    {% if app_release_tag is defined %}
                        <span>Release {{ app_release_tag }}</span>
                    {% endif %}
                </div>
            </div>
        </section>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/admin/js/jquery.min.js') }}"></script>
    <script src="{{ asset('assets/admin/js/adminlte.min.js') }}"></script>
{% endblock %}

{% extends 'auth/layout.html.twig' %}

{% block title %}Sign in — {{ site_title }}{% endblock %}

{% block auth_content %}
    {# Only reached when SSO is not configured (LOGTO_* unset), e.g. a fresh local install. #}
    <span class="atlas-auth-chip">Admin workspace</span>
    <h1 class="atlas-auth-title">Sign in</h1>
    <p class="atlas-auth-sub">Manage posts, pages and settings for {{ site_title|default('the blog') }}.</p>

    {% for message in app.flashes('error') %}
        <div class="atlas-auth-alert" role="alert">{{ message }}</div>
    {% endfor %}

    {% if error %}
        <div class="atlas-auth-alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post" class="atlas-auth-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="atlas-auth-field">
            <label for="login_username">Username or email</label>
            <input id="login_username" type="text" name="_username" value="{{ last_username }}" class="atlas-auth-input"
                   placeholder="your.username" autocomplete="username" autofocus required>
        </div>

        <div class="atlas-auth-field">
            <label for="login_password">Password</label>
            <input id="login_password" type="password" name="_password" class="atlas-auth-input"
                   placeholder="Enter your password" autocomplete="current-password" required>
        </div>

        <div class="atlas-auth-row">
            <label class="atlas-auth-check" for="remember_me">
                <input type="checkbox" name="_remember_me" id="remember_me">
                <span>Remember this device</span>
            </label>
        </div>

        <button type="submit" class="atlas-auth-btn">Sign in</button>
    </form>
{% endblock %}

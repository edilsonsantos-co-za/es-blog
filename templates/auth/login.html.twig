{% extends 'auth/layout.html.twig' %}

{% block title %}Sign In — {{ site_title }}{% endblock %}

{% block auth_content %}
    <div class="auth-card-header">
        <p class="auth-login-eyebrow">Admin workspace</p>
        <h2 class="auth-card-title">Sign in</h2>
        <p class="auth-card-subtitle">Use your EdFolio Blog credentials to manage content, pages, and settings.</p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="auth-alert alert alert-danger alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
            {{ message }}
        </div>
    {% endfor %}

    {% if error %}
        <div class="auth-alert alert alert-danger" role="alert">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post" class="auth-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="auth-field">
            <label class="auth-label" for="login_username">Username or email</label>
            <div class="auth-input-shell">
                <input
                    id="login_username"
                    type="text"
                    name="_username"
                    value="{{ last_username }}"
                    class="auth-input"
                    placeholder="your.username"
                    autocomplete="username"
                    autofocus
                    required
                >
                <span class="auth-input-icon" aria-hidden="true"><i class="fas fa-user"></i></span>
            </div>
        </div>

        <div class="auth-field">
            <label class="auth-label" for="login_password">Password</label>
            <div class="auth-input-shell">
                <input
                    id="login_password"
                    type="password"
                    name="_password"
                    class="auth-input"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required
                >
                <span class="auth-input-icon" aria-hidden="true"><i class="fas fa-lock"></i></span>
            </div>
        </div>

        <div class="auth-options">
            <label class="auth-check" for="remember_me">
                <input type="checkbox" name="_remember_me" id="remember_me">
                <span>Remember this device</span>
            </label>
        </div>

        <button type="submit" class="auth-submit">
            <span>Sign in</span>
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </button>
    </form>
{% endblock %}

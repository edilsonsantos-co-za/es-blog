{% extends 'admin/layout.html.twig' %}

{% block title %}Users{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <p class="admin-kicker">Access control</p>
        <h1 class="m-0">Users</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Users</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="card admin-table-card">
    <div class="card-header d-flex">
        <div>
            <p class="admin-kicker">Team directory</p>
            <h3 class="card-title mb-0">All Users</h3>
        </div>
        <div class="card-tools ml-auto">
            <a href="{{ path('app_admin_user_new') }}" class="btn btn-sm btn-primary">
                <i class="fa fa-user-plus"></i> New User
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover admin-table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Posts</th>
                    <th>MFA</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>
                        {% if user.avatar %}
                        <img src="{{ user.avatar }}" class="admin-avatar mr-2" alt="{{ user.username }} avatar">
                        {% else %}
                        <i class="fa fa-user-circle mr-2 text-muted"></i>
                        {% endif %}
                        <strong>{{ user.username }}</strong>
                        {% if user.id == app.user.id %}
                            <span class="badge badge-secondary ml-1">you</span>
                        {% endif %}
                    </td>
                    <td>{{ user.email ?? '—' }}</td>
                    <td>
                        {% if user.role.value == 'admin' %}
                            <span class="badge badge-info">Admin</span>
                        {% elseif user.role.value == 'editor' %}
                            <span class="badge badge-secondary">Editor</span>
                        {% else %}
                            <span class="badge badge-secondary">Author</span>
                        {% endif %}
                    </td>
                    <td><span class="badge badge-info">{{ user.posts|length }}</span></td>
                    <td>
                        {% if user.mfaEnabled %}
                            <span class="badge badge-success"><i class="fa fa-shield-alt"></i> On</span>
                        {% else %}
                            <span class="badge badge-secondary">Off</span>
                        {% endif %}
                    </td>
                    <td>{{ user.createdAt|date('Y-m-d') }}</td>
                    <td>
                        <div class="admin-actions">
                        <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-xs btn-default">
                            <i class="fa fa-edit"></i> Edit
                        </a>
                        {% if is_granted('USER_DELETE', user) %}
                        <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                              onsubmit="return confirm('Delete user {{ user.username }}? This cannot be undone.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('user_delete_' ~ user.id) }}">
                            <button type="submit" class="btn btn-xs btn-danger" aria-label="Delete {{ user.username }}">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </form>
                        {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7">
                        <div class="admin-empty-state">
                            <i class="fa fa-users" aria-hidden="true"></i>
                            <p class="mb-1">No users found</p>
                            <p class="mb-0">Invite an author, editor, or administrator to start collaborating.</p>
                            <a href="{{ path('app_admin_user_new') }}" class="btn btn-sm btn-primary mt-3">
                                <i class="fa fa-user-plus"></i> New User
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% extends 'admin/layout.html.twig' %}

{% block title %}{{ list_title|default('Posts') }}{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <p class="admin-kicker">Content library</p>
        <h1 class="m-0">{{ list_title|default('Posts') }}</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">{{ list_title|default('Posts') }}</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
{% if route == 'app_admin_posts_drafts' %}
<ul class="nav nav-tabs mb-3" aria-label="Publishing platform">
    {% for key, label in {blog: 'Blog', linkedin: 'LinkedIn', twitter: 'Twitter / X'} %}
    <li class="nav-item"><a class="nav-link {{ platform == key ? 'active' : '' }}"
        href="{{ path('app_admin_posts_drafts', {platform: key}) }}" {% if platform == key %}aria-current="page"{% endif %}>{{ label }}</a></li>
    {% endfor %}
</ul>
<p class="admin-panel-note">Each blog draft has editable LinkedIn and X counterparts. Preview and review first; publish the blog before sharing its link. Sharing is never automatic.</p>
{% endif %}
<div class="card admin-table-card">
    <div class="card-header d-flex">
        <div>
            <p class="admin-kicker">Manage entries</p>
            <h3 class="card-title mb-0">{{ list_title|default('Posts') }}</h3>
        </div>
        <div class="card-tools ml-auto">
            <a href="{{ path('app_admin_post_new') }}" class="btn btn-sm btn-primary">
                <i class="fa fa-plus"></i> New Post
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover admin-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th>Tags</th>
                    <th>Views</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                <tr>
                    <td>
                        <a class="admin-title-link" href="{{ path('app_admin_post_edit', {id: post.id}) }}">{{ post.title|u.truncate(60, '…') }}</a>
                        {% if platform|default('blog') != 'blog' %}
                        <form method="post" action="{{ path('app_admin_post_social_save', {id: post.id, platform: platform}) }}" class="mt-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('post_social_' ~ post.id) }}">
                            <label class="sr-only" for="social-{{ post.id }}">{{ platform == 'linkedin' ? 'LinkedIn' : 'X' }} draft for {{ post.title }}</label>
                            <textarea id="social-{{ post.id }}" name="text" rows="5" class="form-control"
                                maxlength="{{ platform == 'linkedin' ? 3000 : 250 }}">{{ post.customFieldValue(platform ~ '_text') ?? post.title }}</textarea>
                            <button class="btn btn-sm btn-default mt-1" type="submit">Save platform draft</button>
                        </form>
                        <small>Review the saved text before using Share. The blog link is attached on publication.</small>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge badge-info">{{ post.type.label() }}</span>
                    </td>
                    <td>
                        {% if post.status.value == 'published' %}
                            <span class="badge badge-success">Published</span>
                        {% elseif post.status.value == 'draft' %}
                            <span class="badge badge-secondary">Draft</span>
                        {% else %}
                            <span class="badge badge-warning">Scheduled</span>
                        {% endif %}
                    </td>
                    <td>{{ post.author.username }}</td>
                    <td>{{ post.category ? post.category.title : '—' }}</td>
                    <td>
                        {% for tag in post.tags %}
                            <span class="badge badge-secondary">{{ tag.name }}</span>
                        {% endfor %}
                    </td>
                    <td>{{ post.views }}</td>
                    <td>{{ post.createdAt|date('Y-m-d') }}</td>
                    <td>
                        <div class="admin-actions">
                        {% if is_granted('POST_EDIT', post) %}
                        <a href="{{ path('app_admin_post_preview', {id: post.id}) }}" class="btn btn-xs btn-default" target="_blank" rel="noopener" title="Preview saved post">
                            <i class="fa fa-eye" aria-hidden="true"></i><span class="sr-only">Preview {{ post.title }}</span>
                        </a>
                        {% endif %}
                        {% if platform|default('blog') != 'blog' and post.published and is_granted('ROLE_ADMIN') %}
                        <form method="post" action="{{ path(platform == 'linkedin' ? 'app_admin_linkedin_share' : 'app_admin_x_share', {id: post.id}) }}"
                            onsubmit="return confirm('Share this saved, reviewed platform draft publicly?')">
                            <input type="hidden" name="_token" value="{{ csrf_token((platform == 'linkedin' ? 'linkedin_share_' : 'x_share_') ~ post.id) }}">
                            <button type="submit" class="btn btn-xs btn-primary">Share {{ platform == 'linkedin' ? 'LinkedIn' : 'X' }}</button>
                        </form>
                        {% endif %}
                        <a href="{{ path('app_admin_post_edit', {id: post.id}) }}" class="btn btn-xs btn-default" title="Edit">
                            <i class="fa fa-edit" aria-hidden="true"></i><span class="sr-only">Edit {{ post.title }}</span>
                        </a>
                        {% if is_granted('POST_DELETE', post) %}
                        <form method="post" action="{{ path('app_admin_post_delete', {id: post.id}) }}"
                              onsubmit="return confirm('Delete this post?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('post_delete_' ~ post.id) }}">
                            <button type="submit" class="btn btn-xs btn-danger" title="Delete" aria-label="Delete {{ post.title }}">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </form>
                        {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="9">
                        <div class="admin-empty-state">
                            <i class="fa fa-inbox" aria-hidden="true"></i>
                            <p class="mb-1">No posts found</p>
                            <p class="mb-0">Create a new post or adjust your filters to see more content.</p>
                            <a href="{{ path('app_admin_post_new') }}" class="btn btn-sm btn-primary mt-3">
                                <i class="fa fa-plus"></i> New Post
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if posts.pageCount > 1 %}
    <div class="card-footer">
        {{ knp_pagination_render(posts) }}
    </div>
    {% endif %}
</div>
{% endblock %}

{% set admin_theme = config('admin.theme') %}
{% set is_dark = (admin_theme is not null and admin_theme == 'dark') %}
{% set current_route = app.request.attributes.get('_route')|default('') %}
{% set dashboard_active = current_route == 'app_admin_dashboard' %}
{% set add_content_active = current_route == 'app_admin_post_new' %}
{% set posts_active = current_route starts with 'app_admin_post' or current_route starts with 'app_admin_posts' or current_route starts with 'app_admin_categor' or current_route starts with 'app_admin_page' %}
{% set settings_active = current_route starts with 'app_admin_config' or current_route starts with 'app_admin_user' or current_route starts with 'app_admin_menu' %}
{% set maint_active = current_route starts with 'app_admin_cache' or current_route starts with 'app_admin_linkedin' %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — EdFolio Blog</title>
    <link rel="icon" href="{{ asset('favicon.png') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/source-sans.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/solid.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/brands.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/adminlte.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/admin-overhaul.css') }}">
    {% block stylesheets %}{% endblock %}
    <style>
        .error-message ul { margin:0; padding:0; list-style-type:none; }
        .nav-sidebar .nav-item .nav-treeview { display: none; }
        .nav-sidebar .nav-item.menu-open > .nav-treeview { display: block !important; }
        .nav-sidebar .nav-item.menu-open > .nav-link .right { transform: rotate(-90deg); transition: transform .3s ease; }
        .nav-sidebar .nav-item .nav-link .right { transition: transform .3s ease; }
        .badge-published { background:#28a745; }
        .badge-draft { background:#6c757d; }
        .badge-scheduled { background:#fd7e14; }
    </style>
</head>
<body class="hold-transition sidebar-mini admin-shell {{ is_dark ? 'dark-mode' : 'light-mode' }}">
<a href="#admin-main-content" class="skip-link">Skip to main content</a>
<div class="wrapper">

{# ── Navbar ── #}
<nav class="main-header navbar navbar-expand {{ is_dark ? 'navbar-gray-dark navbar-dark' : 'navbar-white navbar-light' }}" id="main-navbar">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle navigation"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-md-flex align-items-center">
            <span class="admin-topbar-title">Admin workspace</span>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a href="/" target="_blank" class="nav-link" title="View Site">
                <i class="fas fa-external-link-alt" style="font-size:18px;"></i>
                <span class="sr-only">View site</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="theme-toggle" href="#" role="button" title="Toggle Dark Mode">
                <i class="fas {{ is_dark ? 'fa-sun' : 'fa-moon' }}" id="theme-icon" style="font-size:18px;"></i>
                <span class="sr-only">Toggle dark mode</span>
            </a>
        </li>
        <li class="nav-item dropdown">
            <a
                class="nav-link d-flex align-items-center justify-content-center"
                id="admin-profile-menu"
                data-toggle="dropdown"
                href="#"
                role="button"
                aria-haspopup="true"
                aria-expanded="false"
                title="Account"
            >
                {% if app.user and app.user.avatar %}
                    <img src="{{ app.user.avatar }}" class="admin-avatar elevation-1" alt="{{ app.user.username }} avatar">
                {% else %}
                    <i class="fas fa-user-circle" style="font-size:22px;"></i>
                {% endif %}
            </a>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="admin-profile-menu">
                <span class="dropdown-item-text text-muted">{{ app.user ? app.user.username : '' }}</span>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_admin_profile') }}" class="dropdown-item"><i class="fas fa-user mr-2"></i> Profile</a>
                <a href="{{ path('app_logout') }}" class="dropdown-item"><i class="fas fa-sign-out-alt mr-2"></i> Logout</a>
            </div>
        </li>
    </ul>
</nav>

{# ── Sidebar ── #}
<aside class="main-sidebar sidebar-dark-primary elevation-4" id="main-sidebar">
    <a href="{{ path('app_admin_dashboard') }}" class="brand-link">
        <i class="fas fa-pen-nib brand-icon" aria-hidden="true"></i>
        <span class="brand-text">
            <span class="brand-title">EdFolio Blog</span>
            <span class="brand-subtitle">Publishing console</span>
        </span>
    </a>
    <div class="sidebar">
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu">

                <li class="nav-header">Overview</li>

                {# Dashboard #}
                <li class="nav-item">
                    <a href="{{ path('app_admin_dashboard') }}" class="nav-link {{ dashboard_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-header">Create</li>

                {# Add Content #}
                <li class="nav-item">
                    <a href="{{ path('app_admin_post_new') }}" class="nav-link {{ add_content_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-plus"></i>
                        <p>Add Content</p>
                    </a>
                </li>

                <li class="nav-header">Manage</li>

                {# Posts expandable #}
                <li class="nav-item has-treeview {{ posts_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ posts_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-thumbtack"></i>
                        <p>Posts <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts') }}" class="nav-link {{ current_route == 'app_admin_posts' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>All Posts</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_mine') }}" class="nav-link {{ current_route == 'app_admin_posts_mine' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>My Posts</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_scheduled') }}" class="nav-link {{ current_route == 'app_admin_posts_scheduled' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Scheduled</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_drafts') }}" class="nav-link {{ current_route == 'app_admin_posts_drafts' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Drafts</p>
                            </a>
                        </li>
                        {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_popular') }}" class="nav-link {{ current_route == 'app_admin_posts_popular' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Popular</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_categories') }}" class="nav-link {{ current_route starts with 'app_admin_categor' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Categories</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_pages') }}" class="nav-link {{ current_route starts with 'app_admin_page' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Pages</p>
                            </a>
                        </li>
                    </ul>
                </li>

                {# Settings expandable #}
                {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                <li class="nav-header">System</li>
                <li class="nav-item has-treeview {{ settings_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ settings_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-cog"></i>
                        <p>Settings <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('app_admin_config') }}" class="nav-link {{ current_route starts with 'app_admin_config' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Configuration</p>
                            </a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_users') }}" class="nav-link {{ current_route starts with 'app_admin_user' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Users</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_menu') }}" class="nav-link {{ current_route starts with 'app_admin_menu' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Navigation Menu</p>
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

                {# Maintenance expandable #}
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item has-treeview {{ maint_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ maint_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-tools"></i>
                        <p>Maintenance <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('app_admin_cache_clear') }}" class="nav-link {{ current_route starts with 'app_admin_cache' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>Clear Cache</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_linkedin') }}" class="nav-link {{ current_route starts with 'app_admin_linkedin' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon" style="font-size:.5rem;"></i><p>LinkedIn</p>
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

            </ul>
        </nav>
    </div>
</aside>

{# ── Content Wrapper ── #}
<main class="content-wrapper" id="admin-main-content" tabindex="-1">
    <div class="content-header">
        <div class="container-fluid">
            {% block page_header %}{% endblock %}
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">

            {# Flash messages #}
            {% for type, messages in app.flashes(['success','error','warning','info']) %}
                {% for message in messages %}
                    {% set alert_class = type == 'error' ? 'danger' : type %}
                    <div class="alert alert-{{ alert_class }} alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <i class="icon fas fa-{{ type == 'success' ? 'check' : (type == 'error' ? 'ban' : (type == 'warning' ? 'exclamation-triangle' : 'info')) }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
    </section>
</main>

{# ── Footer ── #}
<footer class="main-footer">
    <div class="float-right d-none d-sm-inline">
        EdFolio Blog v2 · {{ app_release_tag }}
    </div>
    <strong>Copyright &copy; {{ "now"|date("Y") }} EdFolio</strong>. All rights reserved.
</footer>

</div>{# /.wrapper #}

<script src="{{ asset('assets/admin/js/jquery.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/bootstrap.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/adminlte.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/admin-sidebar.js') }}"></script>
<script>
document.getElementById('theme-toggle').addEventListener('click', function(e) {
    e.preventDefault();
    var body = document.body;
    var isDark = body.classList.contains('dark-mode');
    fetch('{{ path('app_admin_config') }}', {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},
        body: '_token={{ csrf_token('config_general') }}&section=general&admin_theme=' + (isDark ? 'light' : 'dark')
    }).then(function() { window.location.reload(); });
});
</script>
{% block javascripts %}{% endblock %}
</body>
</html>

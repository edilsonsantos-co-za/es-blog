{% set admin_theme = config('admin.theme') %}
{% set is_dark = (admin_theme is not null and admin_theme == 'dark') %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — EdFolio Blog</title>
    <link rel="icon" href="{{ asset('favicon.png') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/source-sans.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/solid.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/brands.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/adminlte.min.css') }}">
    {% block stylesheets %}{% endblock %}
    <style>
        .error-message ul { margin:0; padding:0; list-style-type:none; }
        .nav-sidebar .nav-item .nav-treeview { display: none; }
        .nav-sidebar .nav-item.menu-open > .nav-treeview { display: block !important; }
        .nav-sidebar .nav-item.menu-open > .nav-link .right { transform: rotate(-90deg); transition: transform .3s ease; }
        .nav-sidebar .nav-item .nav-link .right { transition: transform .3s ease; }
        .nav-sidebar .nav-link.active { background-color: rgba(255,255,255,.1) !important; color:#fff !important; }
        .sidebar-dark-primary .nav-sidebar .nav-link.active,
        .light-mode .nav-sidebar .nav-link.active { background-color: #007bff !important; color:#fff !important; }
        .nav-treeview .nav-link.active { background-color: rgba(255,255,255,.15) !important; padding-left:2rem !important; border-left:3px solid #007bff; }
        .badge-published { background:#28a745; }
        .badge-draft { background:#6c757d; }
        .badge-scheduled { background:#fd7e14; }
    </style>
</head>
<body class="hold-transition sidebar-mini {{ is_dark ? 'dark-mode' : 'light-mode' }}">
<script>
(function(){
    var s=localStorage.getItem('open_dropdown_index');
    if(s!==null){document.addEventListener('DOMContentLoaded',function(){
        var d=document.querySelectorAll('.nav-sidebar .nav-item.has-treeview');
        var el=d[parseInt(s)];
        if(el){el.classList.add('menu-open');var t=el.querySelector('.nav-treeview');if(t)t.style.display='block';}
    });}
})();
</script>
<div class="wrapper">

{# ── Navbar ── #}
<nav class="main-header navbar navbar-expand {{ is_dark ? 'navbar-gray-dark navbar-dark' : 'navbar-white navbar-light' }}" id="main-navbar">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fa fa-bars"></i></a>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <a href="/" target="_blank" class="nav-link" title="View Site">
                <i class="fa fa-external-link-alt" style="font-size:18px;"></i>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="theme-toggle" href="#" role="button" title="Toggle Dark Mode">
                <i class="fa {{ is_dark ? 'fa-sun' : 'fa-moon' }}" id="theme-icon" style="font-size:18px;"></i>
            </a>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                {% if app.user and app.user.avatar %}
                    <img src="{{ app.user.avatar }}" class="img-circle elevation-2" style="width:30px;height:30px;object-fit:cover;" alt="Avatar">
                {% else %}
                    <i class="fa fa-user-circle" style="font-size:22px;"></i>
                {% endif %}
            </a>
            <div class="dropdown-menu dropdown-menu-right">
                <span class="dropdown-item-text text-muted">{{ app.user ? app.user.username : '' }}</span>
                <div class="dropdown-divider"></div>
                <a href="{{ path('app_admin_profile') }}" class="dropdown-item"><i class="fa fa-user mr-2"></i> Profile</a>
                <a href="{{ path('app_logout') }}" class="dropdown-item"><i class="fa fa-sign-out-alt mr-2"></i> Logout</a>
            </div>
        </li>
    </ul>
</nav>

{# ── Sidebar ── #}
<aside class="main-sidebar sidebar-dark-primary elevation-4" id="main-sidebar">
    <a href="{{ path('app_admin_dashboard') }}" class="brand-link">
        <i class="fa fa-pen-nib brand-image" style="font-size:24px;margin-left:8px;opacity:.8;"></i>
        <span class="brand-text font-weight-light">EdFolio Blog</span>
    </a>
    <div class="sidebar">
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                {# Dashboard #}
                <li class="nav-item">
                    <a href="{{ path('app_admin_dashboard') }}" class="nav-link {{ app.request.pathInfo == '/admin' ? 'active' : '' }}">
                        <i class="nav-icon fa fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                {# Add Content #}
                <li class="nav-item">
                    <a href="{{ path('app_admin_post_new') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/post/new' ? 'active' : '' }}">
                        <i class="nav-icon fa fa-plus"></i>
                        <p>Add Content</p>
                    </a>
                </li>

                {# Posts expandable #}
                {% set posts_active = app.request.pathInfo starts with '/admin/posts' or app.request.pathInfo starts with '/admin/post/' or app.request.pathInfo starts with '/admin/categories' or app.request.pathInfo starts with '/admin/pages' %}
                <li class="nav-item has-treeview {{ posts_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ posts_active ? 'active' : '' }}">
                        <i class="nav-icon fa fa-thumbtack"></i>
                        <p>Posts <i class="right fa fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts') }}" class="nav-link {{ app.request.pathInfo == '/admin/posts' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>All Posts</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_mine') }}" class="nav-link {{ app.request.pathInfo == '/admin/posts/mine' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>My Posts</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_scheduled') }}" class="nav-link {{ app.request.pathInfo == '/admin/posts/scheduled' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Scheduled</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_drafts') }}" class="nav-link {{ app.request.pathInfo == '/admin/posts/drafts' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Drafts</p>
                            </a>
                        </li>
                        {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_popular') }}" class="nav-link {{ app.request.pathInfo == '/admin/posts/popular' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Popular</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_categories') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/categories' or app.request.pathInfo starts with '/admin/category' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Categories</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_pages') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/pages' or app.request.pathInfo starts with '/admin/page' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Pages</p>
                            </a>
                        </li>
                    </ul>
                </li>

                {# Settings expandable #}
                {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                {% set settings_active = app.request.pathInfo starts with '/admin/config' or app.request.pathInfo starts with '/admin/users' or app.request.pathInfo starts with '/admin/user' or app.request.pathInfo starts with '/admin/menu' %}
                <li class="nav-item has-treeview {{ settings_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ settings_active ? 'active' : '' }}">
                        <i class="nav-icon fa fa-cog"></i>
                        <p>Settings <i class="right fa fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('app_admin_config') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/config' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Configuration</p>
                            </a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_users') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/users' or app.request.pathInfo starts with '/admin/user/' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Users</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_menu') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/menu' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Navigation Menu</p>
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

                {# Maintenance expandable #}
                {% if is_granted('ROLE_ADMIN') %}
                {% set maint_active = app.request.pathInfo starts with '/admin/cache' or app.request.pathInfo starts with '/admin/linkedin' %}
                <li class="nav-item has-treeview {{ maint_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ maint_active ? 'active' : '' }}">
                        <i class="nav-icon fa fa-tools"></i>
                        <p>Maintenance <i class="right fa fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('app_admin_cache_clear') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/cache' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>Clear Cache</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_linkedin') }}" class="nav-link {{ app.request.pathInfo starts with '/admin/linkedin' ? 'active' : '' }}">
                                <i class="fa fa-circle nav-icon" style="font-size:.5rem;"></i><p>LinkedIn</p>
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

            </ul>
        </nav>
    </div>
</aside>

{# ── Content Wrapper ── #}
<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            {% block page_header %}{% endblock %}
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">

            {# Flash messages #}
            {% for type, messages in app.flashes(['success','error','warning','info']) %}
                {% for message in messages %}
                    {% set alert_class = type == 'error' ? 'danger' : type %}
                    <div class="alert alert-{{ alert_class }} alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <i class="icon fas fa-{{ type == 'success' ? 'check' : (type == 'error' ? 'ban' : (type == 'warning' ? 'exclamation-triangle' : 'info')) }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
    </section>
</div>

{# ── Footer ── #}
<footer class="main-footer">
    <div class="float-right d-none d-sm-inline">
        EdFolio Blog v2
    </div>
    <strong>Copyright &copy; {{ "now"|date("Y") }} EdFolio</strong>. All rights reserved.
</footer>

</div>{# /.wrapper #}

<script src="{{ asset('assets/admin/js/jquery.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/adminlte.min.js') }}"></script>
<script>
document.getElementById('theme-toggle').addEventListener('click', function(e) {
    e.preventDefault();
    var body = document.body;
    var isDark = body.classList.contains('dark-mode');
    fetch('{{ path('app_admin_config') }}', {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},
        body: '_token={{ csrf_token('config_general') }}&section=general&admin_theme=' + (isDark ? 'light' : 'dark')
    }).then(function() { window.location.reload(); });
});
// Persist sidebar dropdown state
document.querySelectorAll('.nav-sidebar .nav-item.has-treeview > .nav-link').forEach(function(link, idx) {
    link.addEventListener('click', function() {
        var item = this.parentElement;
        var isOpen = item.classList.contains('menu-open');
        localStorage.setItem('open_dropdown_index', isOpen ? '' : idx);
    });
});
</script>
{% block javascripts %}{% endblock %}
</body>
</html>

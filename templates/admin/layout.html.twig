{% set current_route = app.request.attributes.get('_route')|default('') %}
{% set dashboard_active = current_route == 'app_admin_dashboard' %}
{% set add_content_active = current_route == 'app_admin_post_new' %}
{% set posts_active = current_route in [
    'app_admin_posts',
    'app_admin_posts_mine',
    'app_admin_posts_scheduled',
    'app_admin_posts_drafts',
    'app_admin_posts_popular',
    'app_admin_post_edit',
    'app_admin_categories',
    'app_admin_category_new',
    'app_admin_category_edit',
    'app_admin_pages',
    'app_admin_page_edit'
] %}
{% set settings_active = current_route starts with 'app_admin_config' or current_route starts with 'app_admin_themes' or current_route starts with 'app_admin_user' or current_route starts with 'app_admin_menu' %}
{% set maint_active = current_route starts with 'app_admin_cache' or current_route starts with 'app_admin_linkedin' or current_route starts with 'app_admin_automation' %}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin{% endblock %} — ES Blog</title>
    {# The admin carries the ES app identity (ES mark, "ES Blog") like the other ES apps;
       the site logo and favicon in Settings brand the public blog. #}
    <link rel="icon" type="image/svg+xml" href="{{ asset('assets/brand/es-mark.svg') }}">
    <link rel="alternate icon" type="image/png" sizes="32x32" href="{{ asset('assets/brand/es-icon-32.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('assets/brand/es-icon-180.png') }}">
    <script src="{{ asset('assets/es-apps.js') }}?v={{ asset_version('assets/es-apps.js') }}" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Manrope:wght@500;600;700;800&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/solid.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/brands.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/adminlte.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/admin-overhaul.css') }}">
    {% block stylesheets %}{% endblock %}
    <style>
        .error-message ul { margin:0; padding:0; list-style-type:none; }
        .nav-sidebar .nav-item .nav-treeview { display: none; }
        .nav-sidebar .nav-item.menu-open > .nav-treeview { display: block !important; }
        .nav-sidebar .nav-item.menu-open > .nav-link .right { transform: rotate(-90deg); transition: transform .3s ease; }
        .nav-sidebar .nav-item .nav-link .right { transition: transform .3s ease; }
    </style>
</head>
<body class="hold-transition sidebar-mini admin-shell">
<a href="#admin-main-content" class="skip-link">Skip to main content</a>
<div class="wrapper">

{# ── Navbar ── #}
<nav class="main-header navbar navbar-expand navbar-white navbar-light" id="main-navbar">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle navigation"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-md-flex align-items-center">
            <span class="admin-topbar-title">Blog admin</span>
        </li>
    </ul>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item d-flex align-items-center">
            {# The ES app launcher and account menu, shared by every ES app (public/assets/es-apps.js) #}
            <es-apps current="blog" {% if app.user %}signed-in user-name="{{ app.user.username }}" user-email="{{ app.user.email }}" avatar="{{ gravatar_url(app.user, 128) }}"{% endif %}
                     manage-url="{{ path('app_admin_profile') }}" sign-out-url="{{ path('app_logout') }}"></es-apps>
        </li>
    </ul>
</nav>

{# ── Sidebar ── #}
<aside class="main-sidebar sidebar-light-primary" id="main-sidebar">
    <a href="{{ path('app_admin_dashboard') }}" class="brand-link">
        <span class="brand-logo has-img" aria-hidden="true"><img src="{{ asset('assets/brand/es-mark.svg') }}" alt=""></span>
        <span class="brand-text">
            <span class="brand-title">ES Blog</span>
            <span class="brand-subtitle">Blog admin</span>
        </span>
    </a>
    <div class="sidebar">
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu">

                <li class="nav-header">Overview</li>

                {# Dashboard #}
                <li class="nav-item">
                    <a href="{{ path('app_admin_dashboard') }}" class="nav-link {{ dashboard_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-header">Create</li>

                {# Add Content #}
                <li class="nav-item">
                    <a href="{{ path('app_admin_post_new') }}" class="nav-link {{ add_content_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-plus"></i>
                        <p>Add Content</p>
                    </a>
                </li>

                <li class="nav-header">Manage</li>

                {# Posts expandable #}
                <li class="nav-item has-treeview {{ posts_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ posts_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-thumbtack"></i>
                        <p>Posts <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts') }}" class="nav-link {{ current_route == 'app_admin_posts' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>All Posts</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_mine') }}" class="nav-link {{ current_route == 'app_admin_posts_mine' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>My Posts</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_scheduled') }}" class="nav-link {{ current_route == 'app_admin_posts_scheduled' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Scheduled</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_drafts') }}" class="nav-link {{ current_route == 'app_admin_posts_drafts' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Drafts</p>
                            </a>
                        </li>
                        {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_posts_popular') }}" class="nav-link {{ current_route == 'app_admin_posts_popular' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Popular</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_categories') }}" class="nav-link {{ current_route starts with 'app_admin_categor' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Categories</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_pages') }}" class="nav-link {{ current_route starts with 'app_admin_page' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Pages</p>
                            </a>
                        </li>
                    </ul>
                </li>

                {# Settings expandable #}
                {% if is_granted('ROLE_EDITOR') or is_granted('ROLE_ADMIN') %}
                <li class="nav-header">System</li>
                <li class="nav-item has-treeview {{ settings_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ settings_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-cog"></i>
                        <p>Settings <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('app_admin_config') }}" class="nav-link {{ current_route starts with 'app_admin_config' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Configuration</p>
                            </a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_themes') }}" class="nav-link {{ current_route starts with 'app_admin_themes' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Themes</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_users') }}" class="nav-link {{ current_route starts with 'app_admin_user' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Users</p>
                            </a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a href="{{ path('app_admin_menu') }}" class="nav-link {{ current_route starts with 'app_admin_menu' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Navigation Menu</p>
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

                {# Maintenance expandable #}
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item has-treeview {{ maint_active ? 'menu-open' : '' }}">
                    <a href="#" class="nav-link {{ maint_active ? 'active' : '' }}">
                        <i class="nav-icon fas fa-tools"></i>
                        <p>Maintenance <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('app_admin_cache_clear') }}" class="nav-link {{ current_route starts with 'app_admin_cache' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Clear Cache</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_automation') }}" class="nav-link {{ current_route starts with 'app_admin_automation' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>Feed Automation</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('app_admin_linkedin') }}" class="nav-link {{ current_route starts with 'app_admin_linkedin' ? 'active' : '' }}">
                                <i class="fas fa-circle nav-icon"></i><p>LinkedIn</p>
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

            </ul>
        </nav>
    </div>
</aside>

{# ── Content Wrapper ── #}
<main class="content-wrapper" id="admin-main-content" tabindex="-1">
    <div class="content-header">
        <div class="container-fluid">
            {% block page_header %}{% endblock %}
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">

            {# Flash messages #}
            {% for type, messages in app.flashes(['success','error','warning','info']) %}
                {% for message in messages %}
                    {% set alert_class = type == 'error' ? 'danger' : type %}
                    <div class="alert alert-{{ alert_class }} alert-dismissible fade show js-flash" role="{{ type == 'error' ? 'alert' : 'status' }}" data-flash-timeout="{{ type == 'error' ? 8000 : 5000 }}">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <i class="icon fas fa-{{ type == 'success' ? 'check' : (type == 'error' ? 'ban' : (type == 'warning' ? 'exclamation-triangle' : 'info')) }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
    </section>
</main>

{# ── Footer ── #}
<footer class="main-footer">
    <div class="float-right d-none d-sm-inline">
        ES Blog v2 · {{ app_release_tag }}
    </div>
    &copy; {{ "now"|date("Y") }} <strong>{{ site_title|default('ES Blog') }}</strong>
</footer>

</div>{# /.wrapper #}

<script src="{{ asset('assets/admin/js/jquery.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/bootstrap.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/adminlte.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/admin-sidebar.js') }}"></script>
<script>
// Flash messages close themselves after a few seconds (errors stay a little longer);
// hovering or focusing one holds it open.
document.querySelectorAll('.js-flash').forEach(function (el) {
    var timer;
    var start = function () { timer = setTimeout(function () { $(el).alert('close'); }, +el.dataset.flashTimeout || 5000); };
    var stop = function () { clearTimeout(timer); };
    el.addEventListener('mouseenter', stop);
    el.addEventListener('mouseleave', start);
    el.addEventListener('focusin', stop);
    el.addEventListener('focusout', start);
    start();
});
</script>
{% block javascripts %}{% endblock %}
</body>
</html>

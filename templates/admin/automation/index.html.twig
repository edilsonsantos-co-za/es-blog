{% extends 'admin/layout.html.twig' %}

{% block title %}Feed Automation{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <p class="admin-kicker">Content</p>
        <h1 class="m-0">Feed Automation</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Automation</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
{% set tab = active_tab|default('overview') %}
{% set enabled_sources = sources|filter(s => s.enabled)|length %}

<div class="card admin-card mb-3">
    <div class="card-header p-0">
        <ul class="nav nav-tabs" id="automation-tabs">
            {% for key, t in {
                overview: {route: 'app_admin_automation', icon: 'fa-robot', label: 'Overview'},
                drafts: {route: 'app_admin_posts_drafts', icon: 'fa-pen-nib', label: 'Editorial drafts'},
                feeds: {route: 'app_admin_automation_feeds', icon: 'fa-rss', label: 'Feeds', count: sources|length},
                settings: {route: 'app_admin_automation_settings', icon: 'fa-sliders-h', label: 'Settings'},
            } %}
            <li class="nav-item">
                <a href="{{ path(t.route) }}" class="nav-link {{ tab == key ? 'active' : '' }}" {{ tab == key ? 'aria-current="page"' }}>
                    <i class="fas {{ t.icon }}" aria-hidden="true"></i> {{ t.label }}
                    {% if t.count is defined and t.count %}<span class="badge badge-secondary ml-1">{{ t.count }}</span>{% endif %}
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>

{# ── Overview tab ── #}
{% if tab == 'overview' %}
{% set next_run = settings.nextRunAt %}
<div class="admin-stat-grid cols-4" aria-label="Automation summary">
    <article class="admin-stat-card">
        <div class="admin-stat-top">
            <span class="admin-stat-icon {{ settings.enabled ? 'tone-success' : '' }}" aria-hidden="true"><i class="fas fa-robot"></i></span>
            <span class="badge {{ settings.enabled ? 'badge-success' : 'badge-secondary' }}">{{ settings.enabled ? 'On' : 'Off' }}</span>
        </div>
        <div>
            <span class="admin-stat-label">Schedule</span>
            <span class="admin-stat-number">{{ settings.enabled ? 'Every ' ~ settings.intervalHours ~ 'h' : 'Paused' }}</span>
        </div>
        <span class="admin-stat-help">
            {% if next_run %}Next run {{ next_run|date('j M H:i') }}{% else %}<a href="{{ path('app_admin_automation_settings') }}">Turn it on in Settings</a> to run on a schedule{% endif %}
        </span>
    </article>
    <article class="admin-stat-card">
        <div class="admin-stat-top">
            <span class="admin-stat-icon" aria-hidden="true"><i class="fas fa-rss"></i></span>
            <span class="badge badge-secondary">{{ enabled_sources }} on</span>
        </div>
        <div>
            <span class="admin-stat-label">Feeds</span>
            <span class="admin-stat-number">{{ sources|length }}</span>
        </div>
        <span class="admin-stat-help">Imported from Feeder.co or added by hand</span>
    </article>
    <article class="admin-stat-card">
        <div class="admin-stat-top">
            <span class="admin-stat-icon tone-warning" aria-hidden="true"><i class="fas fa-inbox"></i></span>
            <span class="badge badge-warning">To review</span>
        </div>
        <div>
            <span class="admin-stat-label">New items</span>
            <span class="admin-stat-number">{{ item_counts['new']|default(0) }}</span>
        </div>
        <span class="admin-stat-help">{{ item_counts['skipped']|default(0) }} skipped · {{ item_counts['failed']|default(0) }} failed</span>
    </article>
    <article class="admin-stat-card">
        <div class="admin-stat-top">
            <span class="admin-stat-icon tone-success" aria-hidden="true"><i class="fas fa-pen-nib"></i></span>
            <span class="badge {{ ai_enabled ? 'badge-success' : 'badge-warning' }}">{{ ai_enabled ? 'AI' : 'Key required' }}</span>
        </div>
        <div>
            <span class="admin-stat-label">Posts written</span>
            <span class="admin-stat-number">{{ item_counts['drafted']|default(0) }}</span>
        </div>
        <span class="admin-stat-help">{{ ai_enabled ? 'Written by ' ~ ai_model : 'Set ANTHROPIC_API_KEY for full drafts' }}</span>
    </article>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card admin-card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-play"></i> Run now</h3>
            </div>
            <div class="card-body">
                <p class="admin-panel-note mb-3">
                    Collects enabled feeds and groups two to four distinct articles around each shared topic.
                    AI writes an original synthesis, a banner, and LinkedIn/X counterparts directly into
                    <a href="{{ path('app_admin_posts_drafts') }}">Post drafts</a>.
                    <strong>Nothing is published or shared without review.</strong>
                    {% if not ai_enabled %}<br><strong>ANTHROPIC_API_KEY is missing.</strong> Reading feeds still works, but no placeholder or copied posts will be created.{% endif %}
                </p>
                <form method="post" action="{{ path('app_admin_automation_run') }}" class="form-inline" style="gap:.5rem">
                    <input type="hidden" name="_token" value="{{ csrf_token('automation_run') }}">
                    <label for="run-posts" class="mr-1">Posts to write</label>
                    <select id="run-posts" name="posts" class="form-control form-control-sm">
                        <option value="">Setting ({{ settings.postsPerRun }})</option>
                        <option value="0">0, only read feeds</option>
                        {% for n in 1..3 %}<option value="{{ n }}">{{ n }}</option>{% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm" data-loading-text="Running…">
                        <i class="fas fa-play"></i> Run automation
                    </button>
                </form>
                <p class="admin-form-help mt-2 mb-0">A run with AI drafting can take a minute or two per post.</p>
            </div>
        </div>
        <div class="card admin-card">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-history"></i> Recent runs</h3></div>
            <div class="card-body p-0">
                <table class="table table-sm admin-table mb-0">
                    <thead><tr><th>Started</th><th>Trigger</th><th>Feeds</th><th>New</th><th>Posts</th><th>Log</th></tr></thead>
                    <tbody>
                    {% for run in runs %}
                        <tr>
                            <td class="small text-nowrap">{{ run.startedAt|date('j M H:i') }}</td>
                            <td><span class="badge badge-secondary">{{ run.trigger }}</span></td>
                            <td>{{ run.feedsRead }}</td>
                            <td>{{ run.itemsAdded }}</td>
                            <td>{{ run.postsCreated }}</td>
                            <td>
                                <details>
                                    <summary class="small {{ run.success ? '' : 'text-danger' }}">{{ run.success ? 'OK' : 'Errors' }} · {{ run.log|length }} lines</summary>
                                    <pre class="small mb-0" style="white-space:pre-wrap">{{ run.log|join("\n") }}</pre>
                                </details>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center p-3 text-muted">No runs yet.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card admin-card">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-image"></i> Banner preview</h3></div>
            <div class="card-body">
                <img src="{{ path('app_admin_automation_banner') }}" alt="Example of a generated post banner" class="img-fluid rounded" width="1200" height="630" loading="lazy">
                <p class="admin-form-help mt-2 mb-0">Each post gets a 1200×630 banner like this one. It is the post image, the social preview and the LinkedIn picture.</p>
            </div>
        </div>
        <div class="card admin-card">
            <div class="card-header"><h3 class="card-title"><i class="fab fa-linkedin"></i> LinkedIn</h3></div>
            <div class="card-body">
                {% if linkedin %}
                    <p class="mb-2"><span class="badge badge-success">Connected</span> Published posts are shared to your profile.</p>
                {% else %}
                    <p class="mb-2"><span class="badge badge-secondary">Not connected</span> Posts stay on the blog only.</p>
                {% endif %}
                <a href="{{ path('app_admin_linkedin') }}" class="btn btn-sm btn-default">LinkedIn settings</a>
            </div>
        </div>
    </div>
</div>
{% endif %}

{# ── Items tab ── #}
{% if tab == 'items' %}
<div class="card admin-table-card">
    <div class="card-header d-flex flex-wrap align-items-center" style="gap:.5rem">
        <div>
            <p class="admin-kicker">Found in your feeds</p>
            <h3 class="card-title mb-0">Items</h3>
        </div>
        <div class="btn-group btn-group-sm ml-auto" role="group" aria-label="Filter items">
            {% for key, label in {new: 'New', drafted: 'Written', skipped: 'Skipped', failed: 'Failed', all: 'All'} %}
                <a href="{{ path('app_admin_automation_items', {items: key}) }}" class="btn {{ item_filter == key ? 'btn-primary' : 'btn-default' }}" {{ item_filter == key ? 'aria-current="true"' }}>{{ label }}</a>
            {% endfor %}
        </div>
    </div>
    <div class="card-body p-0">
        <div class="admin-table-wrap">
        <table class="table table-striped table-hover admin-table mb-0">
            <thead><tr><th>Article</th><th>Score</th><th>Published</th><th class="text-right">Actions</th></tr></thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>
                        <a class="admin-title-link" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
                        <div class="small text-muted">{{ item.source.name }}{% if item.summary %} · {{ item.summary|u.truncate(140, '…') }}{% endif %}</div>
                        {% if item.error %}<div class="small text-danger">{{ item.error|u.truncate(200, '…') }}</div>{% endif %}
                    </td>
                    <td><span class="badge {{ item.score >= 3 ? 'badge-success' : (item.score >= 1 ? 'badge-info' : 'badge-secondary') }}">{{ item.score }}</span></td>
                    <td class="small text-nowrap">{{ item.publishedAt ? item.publishedAt|date('j M') : '—' }}</td>
                    <td class="text-right text-nowrap">
                        {% if item.post %}
                            <a class="btn btn-xs btn-default" href="{{ path('app_admin_post_edit', {id: item.post.id}) }}">Open post</a>
                        {% else %}
                            <form method="post" action="{{ path('app_admin_automation_item_draft', {id: item.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('item_' ~ item.id) }}">
                                <button class="btn btn-xs btn-primary" type="submit" data-loading-text="Writing…"><i class="fas fa-pen-nib"></i> Write draft</button>
                            </form>
                            <form method="post" action="{{ path('app_admin_automation_item_skip', {id: item.id, items: item_filter}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('item_' ~ item.id) }}">
                                <button class="btn btn-xs btn-default" type="submit">{{ item.status == 'skipped' ? 'Restore' : 'Skip' }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="admin-empty-state text-center p-4">Nothing here yet. Run the automation to read your feeds.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endif %}

{# ── Feeds tab ── #}
{% if tab == 'feeds' %}
<div class="card admin-card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-rss"></i> Feeds</h3>
    </div>
    <div class="card-body">
        <p class="admin-section-title"><i class="fas fa-file-import" aria-hidden="true"></i> Import from Feeder.co</p>
        <p class="admin-form-help">In Feeder, open <strong>Library → Import &amp; Export → Export to OPML</strong>, then upload the file here. Folders carry over and re-importing skips feeds you already have.</p>
        <form method="post" action="{{ path('app_admin_automation_import') }}" enctype="multipart/form-data" class="d-flex flex-wrap mb-3" style="gap:.5rem">
            <input type="hidden" name="_token" value="{{ csrf_token('automation_import') }}">
            <input type="file" name="opml" accept=".opml,.xml,text/xml,text/x-opml" class="form-control-file" style="max-width:320px" required>
            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-upload"></i> Import OPML</button>
        </form>

        <p class="admin-section-title"><i class="fas fa-plus" aria-hidden="true"></i> Add one feed</p>
        <form method="post" action="{{ path('app_admin_automation_feed_add') }}" class="form-row">
            <input type="hidden" name="_token" value="{{ csrf_token('automation_feed_add') }}">
            <div class="col-md-5 mb-2"><input type="url" name="url" class="form-control form-control-sm" placeholder="https://example.com/feed.xml" required aria-label="Feed URL"></div>
            <div class="col-md-3 mb-2"><input type="text" name="name" class="form-control form-control-sm" placeholder="Name (optional)" aria-label="Feed name"></div>
            <div class="col-md-2 mb-2"><input type="text" name="folder" class="form-control form-control-sm" placeholder="Folder" aria-label="Folder"></div>
            <div class="col-md-2 mb-2"><button type="submit" class="btn btn-sm btn-primary btn-block">Add</button></div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="admin-table-wrap">
        <table class="table table-sm table-hover admin-table mb-0">
            <thead><tr><th>Feed</th><th>Folder</th><th>Last read</th><th class="text-right"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
            {% for source in sources %}
                <tr class="{{ source.enabled ? '' : 'text-muted' }}">
                    <td>
                        <strong>{{ source.name }}</strong>
                        <div class="small text-muted text-truncate" style="max-width:240px" title="{{ source.url }}">{{ source.url }}</div>
                        {% if source.lastError %}<div class="small text-danger">{{ source.lastError|u.truncate(120, '…') }}</div>{% endif %}
                    </td>
                    <td>{{ source.folder ?: '—' }}</td>
                    <td class="small">{{ source.lastFetchedAt ? source.lastFetchedAt|date('j M H:i') : 'Never' }}</td>
                    <td class="text-right text-nowrap">
                        <form method="post" action="{{ path('app_admin_automation_feed_toggle', {id: source.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('feed_' ~ source.id) }}">
                            <button class="btn btn-xs btn-default" type="submit" title="{{ source.enabled ? 'Pause' : 'Resume' }}" aria-label="{{ source.enabled ? 'Pause' : 'Resume' }} {{ source.name }}"><i class="fas fa-{{ source.enabled ? 'pause' : 'play' }}"></i></button>
                        </form>
                        <form method="post" action="{{ path('app_admin_automation_feed_delete', {id: source.id}) }}" class="d-inline" onsubmit="return confirm('Remove this feed and its items?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('feed_' ~ source.id) }}">
                            <button class="btn btn-xs btn-danger" type="submit" aria-label="Remove {{ source.name }}"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="admin-empty-state text-center p-4">No feeds yet. Import your Feeder.co OPML to start.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endif %}

{# ── Settings tab ── #}
{% if tab == 'settings' %}
<div class="row">
    <div class="col-xl-8">
        <div class="card admin-card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-sliders-h"></i> Settings</h3>
            </div>
            <form method="post" action="{{ path('app_admin_automation_settings_save') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('automation_settings') }}">
                <div class="card-body">
                    <div class="custom-control custom-switch mb-3">
                        <input type="checkbox" class="custom-control-input" id="enabled" name="enabled" value="1" {{ settings.enabled ? 'checked' }}>
                        <label class="custom-control-label" for="enabled">Run on a schedule</label>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="interval_hours">Every (hours)</label>
                            <input type="number" min="1" max="168" class="form-control" id="interval_hours" name="interval_hours" value="{{ settings.intervalHours }}">
                        </div>
                        <div class="form-group col-6">
                            <label for="posts_per_run">Posts per run</label>
                            <input type="number" min="0" max="5" class="form-control" id="posts_per_run" name="posts_per_run" value="{{ settings.postsPerRun }}">
                        </div>
                        <div class="form-group col-6">
                            <label for="max_age_days">Ignore older than (days)</label>
                            <input type="number" min="1" max="30" class="form-control" id="max_age_days" name="max_age_days" value="{{ settings.maxAgeDays }}">
                        </div>
                        <div class="form-group col-6">
                            <label for="min_score">Minimum score</label>
                            <input type="number" min="0" max="20" class="form-control" id="min_score" name="min_score" value="{{ settings.minScore }}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="publish_mode">New posts</label>
                        <select class="form-control" id="publish_mode" name="publish_mode">
                            <option value="draft" selected>Save multi-source drafts for editorial review</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="category">Category</label>
                        <select class="form-control" id="category" name="category">
                            <option value="">None</option>
                            {% for category in categories %}
                                <option value="{{ category.slug }}" {{ settings.categorySlug == category.slug ? 'selected' }}>{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="topics">Topics</label>
                        <textarea class="form-control" id="topics" name="topics" rows="2">{{ settings.topicsString }}</textarea>
                        <small class="admin-form-help">Comma separated. A match in the title scores 2, in the summary 1.</small>
                    </div>
                    <div class="form-group mb-0">
                        <label for="voice">Writing voice</label>
                        <textarea class="form-control" id="voice" name="voice" rows="3">{{ settings.voice }}</textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('button[data-loading-text]').forEach(function (button) {
    button.form.addEventListener('submit', function () {
        button.disabled = true;
        button.textContent = button.getAttribute('data-loading-text');
    });
});
</script>
{% endblock %}

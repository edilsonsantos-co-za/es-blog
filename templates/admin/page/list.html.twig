{% extends 'admin/layout.html.twig' %}

{% block title %}Pages{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <h1 class="m-0">Static Pages</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Pages</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header d-flex">
        <h3 class="card-title">All Pages</h3>
        <div class="card-tools ml-auto">
            <a href="{{ path('app_admin_page_new') }}" class="btn btn-sm btn-primary">
                <i class="fa fa-plus"></i> New Page
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Slug</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% set current_page = null %}
                {% for page in pages %}
                    {% if page.type.value == 'page' %}
                        {% set current_page = page %}
                    <tr class="table-active">
                        <td><strong><a href="{{ path('app_admin_page_edit', {id: page.id}) }}">{{ page.title }}</a></strong></td>
                    {% else %}
                    <tr>
                        <td style="padding-left:2rem;"><i class="fa fa-angle-right text-muted mr-1"></i>
                            <a href="{{ path('app_admin_page_edit', {id: page.id}) }}">{{ page.title }}</a>
                        </td>
                    {% endif %}
                        <td><span class="badge badge-info">{{ page.type.label() }}</span></td>
                        <td>
                            {% if page.status.value == 'published' %}
                                <span class="badge badge-success">Published</span>
                            {% else %}
                                <span class="badge badge-secondary">{{ page.status.label() }}</span>
                            {% endif %}
                        </td>
                        <td><code>{{ page.slug }}</code></td>
                        <td>{{ page.createdAt|date('Y-m-d') }}</td>
                        <td style="white-space:nowrap;">
                            <a href="{{ path('app_admin_page_edit', {id: page.id}) }}" class="btn btn-xs btn-default">
                                <i class="fa fa-edit"></i> Edit
                            </a>
                            {% if is_granted('POST_DELETE', page) %}
                            <form method="post" action="{{ path('app_admin_page_delete', {id: page.id}) }}" style="display:inline;"
                                  onsubmit="return confirm('Delete this page?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('post_delete_' ~ page.id) }}">
                                <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No pages yet. <a href="{{ path('app_admin_page_new') }}">Create your first page</a>.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pages.pageCount > 1 %}
    <div class="card-footer">
        {{ knp_pagination_render(pages) }}
    </div>
    {% endif %}
</div>
{% endblock %}

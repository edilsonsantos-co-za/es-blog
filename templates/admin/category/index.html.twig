{% extends 'admin/layout.html.twig' %}

{% block title %}Categories{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <p class="admin-kicker">Taxonomy</p>
        <h1 class="m-0">Categories</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Categories</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
<div class="row">
    {# ── Add / Edit form ── #}
    <div class="col-lg-4">
        {% if edit_category is defined and edit_category %}
        {# Edit form #}
        <div class="card card-warning admin-card">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-edit"></i> Edit Category</h3>
            </div>
            <form method="post" action="{{ path('app_admin_category_edit', {id: edit_category.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('category_form') }}">
                <div class="card-body">
                    <div class="form-group">
                        <label for="edit-title">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="edit-title" name="title"
                               value="{{ edit_category.title }}" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-slug">Slug</label>
                        <input type="text" class="form-control" id="edit-slug" name="slug"
                               value="{{ edit_category.slug }}" placeholder="auto-generated">
                    </div>
                    <div class="form-group mb-0">
                        <label for="edit-description">Description</label>
                        <textarea class="form-control" id="edit-description" name="description" rows="3">{{ edit_category.description }}</textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-save"></i> Update Category
                    </button>
                    <a href="{{ path('app_admin_categories') }}" class="btn btn-default ml-2">Cancel</a>
                </div>
            </form>
        </div>
        {% else %}
        {# Add new category form #}
        <div class="card card-primary admin-card">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-plus"></i> Add Category</h3>
            </div>
            <form method="post" action="{{ path('app_admin_category_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('category_form') }}">
                <div class="card-body">
                    <div class="form-group">
                        <label for="title">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="title" name="title"
                               placeholder="Category name" required>
                    </div>
                    <div class="form-group">
                        <label for="slug">Slug</label>
                        <input type="text" class="form-control" id="slug" name="slug"
                               placeholder="auto-generated from name">
                    </div>
                    <div class="form-group mb-0">
                        <label for="description">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3"
                                  placeholder="Optional description"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Add Category
                    </button>
                </div>
            </form>
        </div>
        {% endif %}
    </div>

    {# ── Categories table ── #}
    <div class="col-lg-8">
        <div class="card admin-table-card">
            <div class="card-header">
                <p class="admin-kicker">Content groups</p>
                <h3 class="card-title mb-0">All Categories</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover admin-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Posts</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in categories %}
                        <tr>
                            <td>
                                <strong class="admin-title-link">{{ row.category.title }}</strong>
                                {% if row.category.description %}
                                <br><small class="text-muted">{{ row.category.description|u.truncate(60, '…') }}</small>
                                {% endif %}
                            </td>
                            <td><code>{{ row.category.slug }}</code></td>
                            <td>
                                <span class="badge badge-secondary">{{ row.postCount }}</span>
                            </td>
                            <td>
                                <div class="admin-actions">
                                {% set cat_id = row.category.id %}
                                <a href="{{ path('app_admin_category_edit', {id: cat_id}) }}" class="btn btn-xs btn-default">
                                    <i class="fa fa-edit"></i> Edit
                                </a>
                                <form method="post" action="{{ path('app_admin_category_delete', {id: cat_id}) }}"
                                      onsubmit="return confirm('Delete this category? Posts will remain but lose their category.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('category_delete_' ~ cat_id) }}">
                                    <button type="submit" class="btn btn-xs btn-danger" aria-label="Delete {{ row.category.title }}">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4">
                                <div class="admin-empty-state">
                                    <i class="fa fa-folder-open" aria-hidden="true"></i>
                                    <p class="mb-1">No categories yet</p>
                                    <p class="mb-0">Add your first category to make posts easier to browse.</p>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// Auto-generate slug from name
function slugify(text) {
    return text.toString().toLowerCase()
        .replace(/\s+/g, '-').replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
}
var titleInput = document.getElementById('title');
var slugInput  = document.getElementById('slug');
if (titleInput && slugInput) {
    titleInput.addEventListener('input', function() {
        if (slugInput.value === '') slugInput.value = slugify(this.value);
    });
}
</script>
{% endblock %}

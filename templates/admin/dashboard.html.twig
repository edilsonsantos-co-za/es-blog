{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <p class="admin-kicker">Admin overview</p>
        <h1 class="m-0">Dashboard</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
{# Dashboard bento: the same tile language as the public Atlas pages. A welcome tile leads, the status counts link to
   their lists, and the most-read recent post fills the last slot. #}
{% set dashboard_stats = [
    {label: 'Published', value: stats.published, icon: 'fa-newspaper', tone: 'tone-success', help: 'Visible on the site', url: path('app_admin_posts')},
    {label: 'Drafts', value: stats.draft, icon: 'fa-pen', tone: '', help: 'Ready for more editing', url: path('app_admin_posts_drafts')},
    {label: 'Scheduled', value: stats.scheduled, icon: 'fa-calendar-alt', tone: 'tone-warning', help: 'Waiting for publish time', url: path('app_admin_posts_scheduled')}
] %}
{% set top_post = recent_posts|length > 0 ? (recent_posts|sort((a, b) => b.views <=> a.views)|first) : null %}
{% set hour = 'now'|date('G') %}

<div class="admin-bento" aria-label="Overview">
    <section class="admin-tile admin-welcome">
        <p class="admin-kicker">{{ site_title }}</p>
        <h2>{{ hour < 12 ? 'Good morning' : (hour < 18 ? 'Good afternoon' : 'Good evening') }}, {{ app.user.username }}.</h2>
        <p class="admin-stat-help">{{ stats.published + stats.draft + stats.scheduled }} posts in total. Pick up a draft or start something new.</p>
        <div class="admin-welcome-actions">
            <a href="{{ path('app_admin_post_new') }}" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> New post</a>
            <a href="{{ path('app_blog_index') }}" class="btn btn-default" target="_blank" rel="noopener">View site ↗</a>
            {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_themes') }}" class="btn btn-default"><i class="fas fa-palette" aria-hidden="true"></i> Themes</a>{% endif %}
        </div>
    </section>
    {% for item in dashboard_stats %}
    <a class="admin-tile admin-stat-card{{ loop.first ? ' is-accent' : '' }}" href="{{ item.url }}">
        <div class="admin-stat-top">
            <span class="admin-stat-label">{{ item.label }}</span>
            <span class="admin-stat-icon {{ item.tone }}" aria-hidden="true"><i class="fas {{ item.icon }}"></i></span>
        </div>
        <span class="admin-stat-number">{{ item.value }}</span>
        <span class="admin-stat-help">{{ item.help }}</span>
    </a>
    {% endfor %}
    <a class="admin-tile admin-stat-card" href="{{ top_post ? path('app_admin_post_edit', {id: top_post.id}) : path('app_admin_posts_popular') }}">
        <div class="admin-stat-top">
            <span class="admin-stat-label">Most read lately</span>
            <span class="admin-stat-icon" aria-hidden="true"><i class="fas fa-chart-line"></i></span>
        </div>
        {% if top_post %}
        <strong class="admin-top-title">{{ top_post.title }}</strong>
        <span class="admin-stat-help">{{ top_post.views }} view{{ top_post.views == 1 ? '' : 's' }}</span>
        {% else %}
        <span class="admin-stat-help">Your most-read recent post shows here once you publish.</span>
        {% endif %}
    </a>
</div>

{# Recent posts #}
<div class="card admin-table-card admin-tile-wide">
    <div class="card-header d-flex">
        <div>
            <p class="admin-kicker">Writing queue</p>
            <h3 class="card-title mb-0">My Recent Posts</h3>
        </div>
        <div class="card-tools ml-auto">
            <a href="{{ path('app_admin_post_new') }}" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> New Post
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover admin-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Views</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in recent_posts %}
                <tr>
                    <td>
                        <a class="admin-title-link" href="{{ path('app_admin_post_edit', {id: post.id}) }}">{{ post.title }}</a>
                    </td>
                    <td>
                        {% if post.status.value == 'published' %}
                            <span class="badge badge-published badge-success">Published</span>
                        {% elseif post.status.value == 'draft' %}
                            <span class="badge badge-secondary">Draft</span>
                        {% else %}
                            <span class="badge badge-warning">Scheduled</span>
                        {% endif %}
                    </td>
                    <td>{{ post.views }}</td>
                    <td>{{ post.createdAt|date('Y-m-d') }}</td>
                    <td>
                        <div class="admin-actions">
                        <a href="{{ path('app_admin_post_edit', {id: post.id}) }}" class="btn btn-xs btn-default">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <form method="post" action="{{ path('app_admin_post_delete', {id: post.id}) }}"
                              onsubmit="return confirm('Delete this post?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('post_delete_' ~ post.id) }}">
                            <button type="submit" class="btn btn-xs btn-danger" aria-label="Delete {{ post.title }}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                        </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5">
                        <div class="admin-empty-state">
                            <i class="fas fa-newspaper" aria-hidden="true"></i>
                            <p class="mb-1">No recent posts yet</p>
                            <p class="mb-0">Start with a draft and it will appear here for quick access.</p>
                            <a href="{{ path('app_admin_post_new') }}" class="btn btn-sm btn-primary mt-3">
                                <i class="fas fa-plus"></i> Create your first post
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if recent_posts|length > 0 %}
    <div class="card-footer text-right">
        <a href="{{ path('app_admin_posts_mine') }}" class="btn btn-sm btn-default">View all my posts →</a>
    </div>
    {% endif %}
</div>
{% endblock %}

{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_header %}
<div class="row mb-2">
    <div class="col-sm-6">
        <h1 class="m-0">Dashboard</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </div>
</div>
{% endblock %}

{% block content %}
{% set dashboard_stats = [
    {
        label: 'Published',
        value: stats.published,
        icon: 'fa-newspaper',
        icon_background: 'bg-gradient-success',
        badge: 'Live',
        badge_class: 'badge-success',
        helper_icon: 'fa-circle-check',
        helper_text: 'Visible on the site'
    },
    {
        label: 'Drafts',
        value: stats.draft,
        icon: 'fa-pen-to-square',
        icon_background: 'bg-gradient-secondary',
        badge: 'In progress',
        badge_class: 'badge-secondary',
        helper_icon: 'fa-pen',
        helper_text: 'Ready for more editing'
    },
    {
        label: 'Scheduled',
        value: stats.scheduled,
        icon: 'fa-calendar-days',
        icon_background: 'bg-gradient-warning',
        badge: 'Queued',
        badge_class: 'badge-warning',
        helper_icon: 'fa-clock',
        helper_text: 'Waiting for publish time'
    }
] %}

{# Stats row #}
<div class="row">
    {% for item in dashboard_stats %}
    <div class="col-12 col-md-6 col-xl-4">
        <div class="info-box shadow-sm">
            <span class="info-box-icon {{ item.icon_background }} elevation-2">
                <i class="fas {{ item.icon }}"></i>
            </span>
            <div class="info-box-content">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="info-box-text text-uppercase text-muted mb-0">{{ item.label }}</span>
                    <span class="badge {{ item.badge_class }}">{{ item.badge }}</span>
                </div>
                <span class="info-box-number mb-1">{{ item.value }}</span>
                <span class="text-muted text-sm">
                    <i class="fas {{ item.helper_icon }} mr-1"></i>{{ item.helper_text }}
                </span>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

{# Recent posts #}
<div class="card">
    <div class="card-header d-flex">
        <h3 class="card-title">My Recent Posts</h3>
        <div class="card-tools ml-auto">
            <a href="{{ path('app_admin_post_new') }}" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> New Post
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Views</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in recent_posts %}
                <tr>
                    <td>
                        <a href="{{ path('app_admin_post_edit', {id: post.id}) }}">{{ post.title }}</a>
                    </td>
                    <td>
                        {% if post.status.value == 'published' %}
                            <span class="badge badge-published badge-success">Published</span>
                        {% elseif post.status.value == 'draft' %}
                            <span class="badge badge-secondary">Draft</span>
                        {% else %}
                            <span class="badge badge-warning">Scheduled</span>
                        {% endif %}
                    </td>
                    <td>{{ post.views }}</td>
                    <td>{{ post.createdAt|date('Y-m-d') }}</td>
                    <td>
                        <a href="{{ path('app_admin_post_edit', {id: post.id}) }}" class="btn btn-xs btn-default">
                            <i class="fas fa-pen-to-square"></i> Edit
                        </a>
                        <form method="post" action="{{ path('app_admin_post_delete', {id: post.id}) }}" style="display:inline;"
                              onsubmit="return confirm('Delete this post?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('post_delete_' ~ post.id) }}">
                            <button type="submit" class="btn btn-xs btn-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted">No posts yet. <a href="{{ path('app_admin_post_new') }}">Create your first post</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if recent_posts|length > 0 %}
    <div class="card-footer text-right">
        <a href="{{ path('app_admin_posts_mine') }}" class="btn btn-sm btn-default">View all my posts →</a>
    </div>
    {% endif %}
</div>
{% endblock %}

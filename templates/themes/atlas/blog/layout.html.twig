<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ site_title }}{% endblock %}</title>

    {% block meta_description %}
    {% if site_description is defined and site_description %}
    <meta name="description" content="{{ site_description }}">
    {% endif %}
    {% endblock %}

    {% block canonical %}{% endblock %}

    {% block opengraph %}
    <meta property="og:site_name" content="{{ site_title }}">
    <meta property="og:type" content="website">
    {% endblock %}

    <script>
    (function () {
        try {
            var mode = localStorage.getItem('edfolio-public-theme-mode');
            if (mode === 'dark' || mode === 'light') {
                document.documentElement.setAttribute('data-theme', mode);
            }
        } catch (e) {}
    })();
    </script>

    {% block css %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Manrope:wght@500;600;700;800&display=swap">
    <link rel="stylesheet" href="/assets/themes/atlas/atlas.css">
    {% endblock %}

    {% if config('site.favicon') %}<link rel="icon" href="{{ config('site.favicon') }}">{% elseif site_logo %}<link rel="icon" href="{{ site_logo }}">{% endif %}

    <link rel="alternate" type="application/rss+xml" title="{{ site_title }} RSS Feed" href="{{ path('app_blog_feed') }}">
</head>
{% set portfolio_url = site_portfolio_url starts with 'http' ? site_portfolio_url : '' %}
{% set current_route = app.request.attributes.get('_route') %}
<body class="theme-atlas {% block body_class %}{% endblock %}">
<a class="skip-link" href="#main">Skip to content</a>

<header class="masthead">
    <div class="wrap mast-row">
        <a href="{{ path('app_blog_index') }}" class="brand" aria-label="{{ site_title }} home">
            {% if site_logo %}
                <span class="logo logo-img"><img src="{{ site_logo }}" alt=""></span>
            {% else %}
                <span class="logo" aria-hidden="true">{{ site_title|first|upper }}</span>
            {% endif %}
            <span class="brand-text">
                <b>{{ site_title }}</b>
                <small class="mono">Journal</small>
            </span>
        </a>

        <nav class="mast-nav" aria-label="Primary navigation">
            <ul class="nav" id="menu">
                <li><a href="{{ path('app_blog_index') }}"{% if current_route == 'app_blog_index' %} aria-current="page"{% endif %}>Latest</a></li>
                {% for item in menu_items %}
                    {% set has_children = item.children is defined and item.children|length > 0 %}
                    <li{% if has_children %} class="has-sub"{% endif %}>
                        <a href="{{ item.url }}">{{ item.label }}</a>
                        {% if has_children %}
                        <ul class="sub">
                            {% for child in item.children %}
                            <li><a href="{{ child.url }}">{{ child.label }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                {% endfor %}
                {% for cat in all_categories|slice(0, 3) %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}"{% if app.request.attributes.get('slug') == cat.slug and current_route == 'app_blog_category' %} aria-current="page"{% endif %}>{{ cat.title }}</a></li>
                {% endfor %}
                <li class="nav-mobile-only search-link"><a href="{{ path('app_blog_search') }}">Search</a></li>
                {% if portfolio_url %}
                <li class="nav-mobile-only"><a href="{{ portfolio_url }}">Portfolio ↗</a></li>
                {% endif %}
                <li class="nav-mobile-only"><a href="{{ path('app_login') }}">Sign in</a></li>
            </ul>
        </nav>

        <form class="mast-search" action="{{ path('app_blog_search') }}" method="get" role="search">
            <label class="sr-only" for="mast-search-input">Search posts</label>
            <span aria-hidden="true">⌕</span>
            <input id="mast-search-input" type="search" name="q" placeholder="Search posts" value="{{ app.request.query.get('q') }}">
            <kbd aria-hidden="true">/</kbd>
        </form>

        <div class="top-actions">
            {% if portfolio_url %}
            <a class="btn btn-outline portfolio-btn" href="{{ portfolio_url }}">Portfolio ↗</a>
            {% endif %}
            <button class="icon-btn theme-toggle" id="theme-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8z"/></svg>
                <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
            <a class="btn signin" href="{{ path('app_login') }}">Sign in</a>
            <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu">☰</button>
        </div>
    </div>
</header>

<div class="wrap page {% block page_class %}with-sidebar{% endblock %}">
    <main class="main-content" id="main" tabindex="-1">
        {% block content %}{% endblock %}
    </main>

    {% block sidebar_wrap %}
    <aside class="sidebar" id="sidebar" aria-label="Blog sidebar">
        {% block sidebar %}
        <div class="tile widget widget-search">
            <h2 class="label">Search</h2>
            <form action="{{ path('app_blog_search') }}" method="get" class="search-form">
                <label class="sr-only" for="sidebar-search">Search posts</label>
                <input id="sidebar-search" type="text" name="q" placeholder="Symfony, Docker…" class="search-input">
                <button type="submit" class="btn primary search-btn">Go</button>
            </form>
        </div>

        {% if recent_posts|length > 0 %}
        <div class="tile widget widget-recent-posts">
            <h2 class="label">Recently published</h2>
            <ul class="sidebar-link-list">
                {% for p in recent_posts %}
                <li>
                    <a href="{{ path('app_blog_post', {
                        year: (p.publishedAt ?? p.createdAt)|date('Y'),
                        month: (p.publishedAt ?? p.createdAt)|date('m'),
                        slug: p.slug
                    }) }}">{{ p.title }}</a>
                    <span class="mono">{{ (p.publishedAt ?? p.createdAt)|date('M j, Y') }}</span>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if tag_cloud|length > 0 %}
        <div class="tile widget widget-tags">
            <h2 class="label">Tags</h2>
            <div class="tag-cloud">
                {% for item in tag_cloud %}
                <a href="{{ path('app_blog_tag', {slug: item.tag.slug}) }}" class="tag-pill">
                    {{ item.tag.name }} <span class="tag-count">{{ item.postCount }}</span>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if all_categories|length > 0 %}
        <div class="tile widget widget-categories">
            <h2 class="label">Categories</h2>
            <ul class="sidebar-link-list compact">
                {% for cat in all_categories %}
                <li><a href="{{ path('app_blog_category', {slug: cat.slug}) }}">{{ cat.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        {% endblock %}
    </aside>
    {% endblock %}
</div>

<footer class="foot">
    <div class="wrap foot-grid">
        <div class="tile foot-tile">
            <p class="label">{{ site_title }}</p>
            {% if site_description %}<p class="foot-copy">{{ site_description }}</p>{% endif %}
        </div>
        <div class="foot-meta">
            <a href="{{ path('app_blog_feed') }}">RSS</a>
            {% if portfolio_url %}<a href="{{ portfolio_url }}">Portfolio</a>{% endif %}
            <span>&copy; {{ "now"|date("Y") }}</span>
            <span class="mono">{{ app_release_tag }}</span>
        </div>
    </div>
</footer>

<script>
(function () {
    var root = document.documentElement;
    var key = 'edfolio-public-theme-mode';
    var themeBtn = document.getElementById('theme-btn');

    function isDark() {
        var forced = root.getAttribute('data-theme');
        if (forced) { return forced === 'dark'; }
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    themeBtn.addEventListener('click', function () {
        var next = isDark() ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem(key, next); } catch (e) {}
    });

    var menuBtn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu');
    menuBtn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
        }, { threshold: 0.08 });
        document.querySelectorAll('.post-row, .hero > *').forEach(function (el) {
            el.classList.add('reveal');
            io.observe(el);
        });
    }

    var searchInput = document.getElementById('mast-search-input');
    document.addEventListener('keydown', function (e) {
        var tag = (e.target.tagName || '').toLowerCase();
        if (e.key === '/' && searchInput && tag !== 'input' && tag !== 'textarea') {
            e.preventDefault();
            searchInput.focus();
        }
    });

    var clock = document.querySelector('[data-clock]');
    if (clock) {
        var tz = clock.getAttribute('data-clock');
        var tick = function () {
            try {
                clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: tz });
            } catch (e) {
                clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            }
        };
        tick();
        setInterval(tick, 15000);
    }
})();
</script>
</body>
</html>

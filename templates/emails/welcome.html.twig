{% extends 'emails/_layout.html.twig' %}
{% block preheader %}Your ES Blog author account is ready.{% endblock %}
{% block eyebrow %}Author account{% endblock %}
{% block body %}
<p style="margin:0 0 16px;">Hi {{ name }}, an author account on ES Blog has been created for you.</p>
<p style="margin:0 0 16px;">Sign in with your DataSparkLab account using this email address ({{ email }}). From there you can write drafts, upload images and publish posts.</p>
{% include 'emails/_button.html.twig' with {href: login_url, label: 'Sign in to ES Blog'} %}
<p style="margin:0;font-size:13px;line-height:1.6;color:#6E6E79;">Not expecting this? You can ignore this email: nobody can sign in as you without your DataSparkLab password.</p>
{% endblock %}

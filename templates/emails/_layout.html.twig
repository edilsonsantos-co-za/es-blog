{# Shared frame for every blog email: same look as the SSO emails (brand row, white card, small footer).
   Inline styles only, since mail clients drop most <style> rules. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f5f9;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f3f5f9;padding:32px 12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <tr><td align="center">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{% block preheader %}{% endblock %}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
      <tr><td style="padding:0 4px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
          <td width="22" height="22" style="width:22px;height:22px;background:#2563eb;border-radius:7px;font-size:0;line-height:0;">&nbsp;</td>
          <td style="padding-left:10px;font-size:17px;font-weight:700;color:#0f172a;">ES Blog</td>
        </tr></table>
      </td></tr>
      <tr><td style="background:#ffffff;border:1px solid #e3e8f0;border-radius:16px;padding:36px 36px 32px;font-size:15px;line-height:1.6;color:#334155;">
        <h1 style="margin:0 0 14px;font-size:22px;line-height:1.3;font-weight:700;color:#0f172a;">{{ subject }}</h1>
        {% block body %}{% endblock %}
      </td></tr>
      <tr><td style="padding:18px 8px 0;font-size:12px;line-height:1.6;color:#94a3b8;text-align:center;">
        {% block footer %}Edilson Santos · blog.edilsonsantos.co.za{% endblock %}
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>

APP_ENV=prod
APP_SECRET=                          # 32-char random string: php -r "echo bin2hex(random_bytes(16));"

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/edfolio_blog?serverVersion=8.0&charset=utf8mb4"

SITE_NAME="EdFolio Blog"
SITE_URL=https://blog.edilsonsantos.co.za/

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://blog.edilsonsantos.co.za/admin/linkedin/callback
# LINKEDIN_API_VERSION=202608

MAILER_DSN=smtp://user:password@smtp.example.com:587

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Feed automation: Claude writes posts from your feeds. Without a key, drafts are skeletons to fill in.
ANTHROPIC_API_KEY=
# AUTOMATION_AI_MODEL=claude-opus-5-5

# Admin -> Themes: ES Marketplace store to install themes from (default https://store.edilsonsantos.co.za)
# THEME_STORE_URL=https://store.edilsonsantos.co.za
# Install theme packages that are not signed by the store (not recommended)
# THEMES_ALLOW_UNSIGNED=0

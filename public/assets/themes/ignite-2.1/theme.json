{
  "name": "Ignite",
  "version": "2.1",
  "author": "CompeteThemes",
  "homepage": "https://www.competethemes.com",
  "description": "Ignite theme ported to HTMLy.",
  "settings": [
    {
      "type": "checkbox",
      "name": "ignite_search",
      "label": "Search Form",
      "value": "",

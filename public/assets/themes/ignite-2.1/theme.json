    {
      "type": "checkbox",
      "name": "category_list",
      "label": "Category List",
      "value": "",
      "info": "Enable Category List widget"
    },
    {
      "type": "checkbox",
      "name": "tagcloud",
      "label": "TagCloud",
      "value": "",
      "info": "Enable TagCloud widget"
    }
  ]
